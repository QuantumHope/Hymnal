<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             xmlns:models="using:Hymnal.Core.Models"
             xmlns:conv="using:Hymnal.Views.Converters"
             xmlns:controls="using:Hymnal.Views.Controls"
             x:Class="Hymnal.Views.ChapterInfoView"
             x:DataType="vm:ChapterInfoViewModel"
             Background="{DynamicResource Cora.Surface.Panel}">

    <Panel>

        <!-- Empty state: shown when no chapter is active -->
        <TextBlock Text="{Binding EmptyStateText}"
                   IsVisible="{Binding ChapterTitle, Converter={x:Static ObjectConverters.IsNull}}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Cora.Text.Disabled}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="12"
                   Margin="16" />

        <!-- Content panel: visible when a chapter is open -->
        <ScrollViewer IsVisible="{Binding ChapterTitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10,12,16" Spacing="10">

                <!-- Chapter title -->
                <TextBlock Text="{Binding ChapterTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Cora.Text}"
                           TextWrapping="Wrap" />

                <Separator Background="{DynamicResource Cora.Border.Subtle}" Height="1" />

                <!-- Status -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="caps" Text="STATUS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                    <!-- x:Name="StatusComboBox" — SelectionChanged is wired in code-behind -->
                    <ComboBox x:Name="StatusComboBox"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedValueBinding="{Binding Value, DataType=models:StatusOption}"
                              SelectedValue="{Binding DisplayStatus, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              Padding="8,6"
                              Background="{DynamicResource Cora.Surface.Void}"
                              Foreground="{DynamicResource Cora.Text}"
                              BorderBrush="{DynamicResource Cora.Border.Subtle}"
                              BorderThickness="1">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:StatusOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding Value, Converter={x:Static conv:StatusToBrushConverter.Instance}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Phase Start Date -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="caps" Text="PHASE SCHEDULE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />

                    <!-- Column header row -->
                    <Grid ColumnDefinitions="80,*,*,44">
                        <TextBlock Classes="caps" Grid.Column="0" Text="Phase"
                                   FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                   Foreground="{DynamicResource Cora.Text.Disabled}" />
                        <TextBlock Classes="caps" Grid.Column="1" Text="Start"
                                   FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                   Foreground="{DynamicResource Cora.Text.Disabled}" />
                        <TextBlock Classes="caps" Grid.Column="2" Text="End"
                                   FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                   Foreground="{DynamicResource Cora.Text.Disabled}" />
                        <TextBlock Classes="caps" Grid.Column="3" Text="%"
                                   FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                   Foreground="{DynamicResource Cora.Text.Disabled}"
                                   HorizontalAlignment="Center" />
                    </Grid>

                    <!-- One row per phase; bound to PhaseScheduleRows -->
                    <ItemsControl x:Name="PhaseScheduleTable" ItemsSource="{Binding PhaseScheduleRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhaseScheduleRowViewModel">
                                <Grid ColumnDefinitions="80,*,*,44"
                                      Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding PhaseName}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding StartDate, Mode=TwoWay}"
                                             PlaceholderText="YYYY-MM-DD"
                                             Background="{DynamicResource Cora.Surface.Void}"
                                             Foreground="{DynamicResource Cora.Text}"
                                             BorderBrush="{DynamicResource Cora.Border.Subtle}"
                                             BorderThickness="1"
                                             FontSize="11"
                                             Padding="4,4"
                                             Margin="0,0,4,0" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding EndDate, Mode=TwoWay}"
                                             PlaceholderText="YYYY-MM-DD"
                                             Background="{DynamicResource Cora.Surface.Void}"
                                             Foreground="{DynamicResource Cora.Text}"
                                             BorderBrush="{DynamicResource Cora.Border.Subtle}"
                                             BorderThickness="1"
                                             FontSize="11"
                                             Padding="4,4"
                                             Margin="0,0,4,0" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Progress, Mode=TwoWay,
                                                            Converter={x:Static conv:NullableDoubleToStringConverter.Instance}}"
                                             PlaceholderText="—"
                                             Background="{DynamicResource Cora.Surface.Void}"
                                             Foreground="{DynamicResource Cora.Text}"
                                             BorderBrush="{DynamicResource Cora.Border.Subtle}"
                                             BorderThickness="1"
                                             FontSize="11"
                                             Padding="4,4"
                                             TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Auto-saved indicator -->
                    <TextBlock Text="✓ Saved"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource Cora.Text.Disabled}"
                               IsVisible="{Binding ScheduleSavedRecently}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Separator Background="{DynamicResource Cora.Border.Subtle}" Height="1" />

                <!-- Word Count -->
                <StackPanel Spacing="2">
                    <TextBlock Classes="caps" Text="WORDS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                    <TextBlock Text="{Binding WordCountDisplay}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Cora.Text}" />
                </StackPanel>

                <!-- Proximity bar (visible only when a target is set) -->
                <ProgressBar Value="{Binding ProximityFill}"
                             Minimum="0"
                             Maximum="1"
                             IsVisible="{Binding HasTarget}"
                             Height="4"
                             CornerRadius="2"
                             Foreground="{DynamicResource Cora.Accent.Store}"
                             Background="{DynamicResource Cora.Wash.Selected}" />

                <!-- Word count history chart -->
                <StackPanel Spacing="6"
                            IsVisible="{Binding HasHistoryItems}">
                    <TextBlock Classes="caps" Text="WORDS BY DAY"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                    <controls:WordCountHistoryChart Items="{Binding HistoryItems}" />
                </StackPanel>

                <!-- Target -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="caps" Text="TARGET"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                    <!-- Current target display (shown when target is set) -->
                    <TextBlock Text="{Binding TargetDisplay}"
                               IsVisible="{Binding HasTarget}"
                               FontSize="12"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                    <!-- Story-length preset (story / anthology only) -->
                    <ComboBox ItemsSource="{Binding TargetPresets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              IsVisible="{Binding HasTargetPresets}"
                              PlaceholderText="Length preset"
                              HorizontalAlignment="Stretch"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TargetPreset">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Input field -->
                    <TextBox Text="{Binding PendingTarget, Mode=TwoWay,
                                            Converter={x:Static conv:NullableIntToStringConverter.Instance}}"
                             PlaceholderText="e.g. 5000"
                             Background="{DynamicResource Cora.Surface.Void}"
                             Foreground="{DynamicResource Cora.Text}"
                             BorderBrush="{DynamicResource Cora.Border.Subtle}"
                             BorderThickness="1"
                             FontSize="12"
                             Padding="8,6" />
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0"
                                Content="Set Target"
                                Command="{Binding SetTargetCommand}"
                                CommandParameter="{Binding PendingTarget}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Cora.Wash.Selected}"
                                Foreground="{DynamicResource Cora.Accent.Store}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="8,6"
                                FontSize="12" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding SetTargetCommand}"
                                CommandParameter="{x:Null}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource Cora.Wash.Selected}"
                                Foreground="{DynamicResource Cora.Text.Secondary}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="8,6"
                                FontSize="12" />
                    </Grid>
                </StackPanel>

                <Separator Background="{DynamicResource Cora.Border.Subtle}" Height="1" />

                <!-- Pre-fill toggle -->
                <CheckBox Content="Auto-fill today on status change"
                          IsChecked="{Binding PrefillPhaseDate, Mode=TwoWay}"
                          FontSize="12"
                          Foreground="{DynamicResource Cora.Text.Secondary}" />

            </StackPanel>
        </ScrollViewer>

    </Panel>

</UserControl>
