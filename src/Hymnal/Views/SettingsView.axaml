<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             xmlns:aivm="using:Hymnal.ViewModels.Ai"
             xmlns:conv="using:Hymnal.Views.Converters"
             xmlns:views="using:Hymnal.Views"
             x:Class="Hymnal.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">

    <UserControl.Styles>
        <Style Selector="Button.typeCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Width" Value="230" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.typeCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SynthwavePurpleBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="160,*" Margin="0">

        <!-- Left nav -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="0,16">
            <StackPanel Spacing="2" Margin="8,0">
                <TextBlock Text="Project"
                           IsVisible="{Binding HasWorkspace}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SynthwavePurpleBrush}"
                           Padding="8,6" />
                <TextBlock Text="Sound"
                           IsVisible="{Binding HasSound}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SynthwavePurpleBrush}"
                           Padding="8,6" />
                <TextBlock Text="Updates"
                           IsVisible="{Binding HasUpdates}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SynthwavePurpleBrush}"
                           Padding="8,6" />
                <TextBlock Text="AI Providers"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SynthwavePurpleBrush}"
                           Padding="8,6"
                           Background="{DynamicResource SurfaceOverlayBrush}"
                           />
            </StackPanel>
        </Border>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel Spacing="16" MaxWidth="760">

                <!-- Project section -->
                <StackPanel Spacing="12" IsVisible="{Binding HasWorkspace}">
                    <TextBlock Text="Project"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ProjectCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectTypeCardViewModel">
                                    <Button Classes="typeCard"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectProjectKindCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="8">
                                            <!-- Outline icons: stroke on a 24x24 canvas (PathIcon would fill the open subpaths). -->
                                            <Viewbox Width="40" Height="40" HorizontalAlignment="Left">
                                                <Path Width="24" Height="24"
                                                      Stroke="{DynamicResource SynthwavePurpleBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      Data="{Binding Info.IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding Info.Title}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                                            <TextBlock Text="{Binding Info.Description}"
                                                       Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Info.Impact}" FontSize="12"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Spacing="4" IsVisible="{Binding IsStorageOptionVisible}">
                        <CheckBox Content="Keep everything in the story file"
                                  IsChecked="{Binding KeepInStoryFile}"
                                  IsEnabled="{Binding IsStorageOptionEnabled}"
                                  Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Text="{Binding StorageOptionExplanation}"
                                   IsVisible="{Binding StorageOptionExplanation, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProjectChangeSummary}"
                               IsVisible="{Binding ProjectChangeSummary, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                    <TextBlock Text="{Binding ReopenRequiredMessage}"
                               IsVisible="{Binding ReopenRequiredMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                    <Button Content="Apply"
                            Command="{Binding ApplyProjectKindCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            FontSize="12"
                            Background="{DynamicResource SynthwavePurpleBrush}"
                            Foreground="White"
                            CornerRadius="5" />
                </StackPanel>

                <!-- Sound section -->
                <StackPanel x:Name="PART_SoundSection" Spacing="10" IsVisible="{Binding HasSound}">
                    <TextBlock Text="Sound"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="PART_SoundEnabledCheckBox"
                                  Content="Play sounds"
                                  IsChecked="{Binding Sound.Preferences.SoundEnabled}"
                                  Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Text="Hymnal's sounds, starting with a typing sound as you type and delete on the Write surface. Moving the caret stays quiet."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="110,Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8"
                          HorizontalAlignment="Left">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Typing sound"
                                   VerticalAlignment="Center"
                                   IsEnabled="{Binding Sound.CanChooseTypingSound}"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <ComboBox x:Name="PART_TypingSoundComboBox"
                                  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                  MinWidth="300"
                                  ItemsSource="{Binding Sound.TypingSoundOptions}"
                                  SelectedItem="{Binding Sound.SelectedTypingSound}"
                                  IsEnabled="{Binding Sound.CanChooseTypingSound}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TypingSoundOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding Sound.SelectedTypingSound.Description}"
                                   MaxWidth="460"
                                   HorizontalAlignment="Left"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsEnabled="{Binding Sound.CanChooseTypingSound}"
                                   Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Volume"
                                   VerticalAlignment="Center"
                                   IsEnabled="{Binding Sound.IsTypingSoundAudible}"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <Slider x:Name="PART_TypingVolumeSlider"
                                Grid.Row="2" Grid.Column="1"
                                Width="240"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                IsEnabled="{Binding Sound.IsTypingSoundAudible}"
                                Value="{Binding Sound.Preferences.TypingVolume}" />
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="{Binding Sound.Preferences.TypingVolume, StringFormat={}{0:P0}}"
                                   MinWidth="44"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Foreground="{DynamicResource OnSurfaceDimBrush}" />
                        <Button x:Name="PART_PreviewSoundButton"
                                Grid.Row="2" Grid.Column="3"
                                Command="{Binding Sound.PreviewCommand}"
                                ToolTip.Tip="Play a few typed words with this sound"
                                Padding="12,6"
                                FontSize="12"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource Icon.Play}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource SynthwavePurpleBrush}"
                                      Fill="{DynamicResource SynthwavePurpleBrush}"
                                      StrokeThickness="1.5"
                                      StrokeJoin="Round" />
                                <TextBlock Text="Preview" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Sound.StatusMessage}"
                               IsVisible="{Binding Sound.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                </StackPanel>

                <!-- Updates section -->
                <views:UpdatesSettingsView DataContext="{Binding Updates}"
                                           IsVisible="{Binding IsAvailable, FallbackValue=False}" />

                <!-- Section header -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="AI Providers"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <Button Grid.Column="1"
                            Content="+ Add provider"
                            Command="{Binding AddProfileCommand}"
                            Padding="10,6"
                            FontSize="12"
                            Background="{DynamicResource SynthwavePurpleBrush}"
                            Foreground="White"
                            CornerRadius="5" />
                </Grid>

                <!-- Provider list -->
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="aivm:ProviderProfileViewModel">
                            <Border Margin="0,0,0,12"
                                    Padding="16,14"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}">
                                <StackPanel Spacing="10">

                                    <!-- Header row -->
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource OnSurfaceMutedBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="BaseUrl" />
                                                        <Binding Path="ModelId" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Set active"
                                                Command="{Binding SetActiveCommand}"
                                                IsVisible="{Binding !IsActive}"
                                                Margin="8,0,0,0"
                                                Padding="8,4"
                                                FontSize="11"
                                                Background="{DynamicResource SurfaceOverlayBrush}"
                                                Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                CornerRadius="4" />
                                        <TextBlock Grid.Column="2"
                                                   Text="Active ✓"
                                                   IsVisible="{Binding IsActive}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="11"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Edit fields -->
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="120,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="Provider type"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding AvailableTypes}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  FontSize="12"
                                                  Margin="0,0,0,6"
                                                  Background="{DynamicResource SurfaceBaseBrush}"
                                                  Foreground="{DynamicResource OnSurfaceBrush}"
                                                  BorderThickness="1"
                                                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                  CornerRadius="4"
                                                  Padding="6,4"
                                                  HorizontalAlignment="Stretch" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding BaseUrlLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding BaseUrl, Mode=TwoWay}"
                                                 FontSize="12"
                                                 Margin="0,0,0,6"
                                                 Background="{DynamicResource SurfaceBaseBrush}"
                                                 Foreground="{DynamicResource OnSurfaceBrush}"
                                                 BorderThickness="1"
                                                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                 CornerRadius="4"
                                                 Padding="6,4" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{Binding ModelIdLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding ModelId, Mode=TwoWay}"
                                                 FontSize="12"
                                                 Margin="0,0,0,6"
                                                 Background="{DynamicResource SurfaceBaseBrush}"
                                                 Foreground="{DynamicResource OnSurfaceBrush}"
                                                 BorderThickness="1"
                                                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                 CornerRadius="4"
                                                 Padding="6,4" />

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="{Binding ApiKeyHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding ApiKey, Mode=TwoWay}"
                                                 PasswordChar="•"
                                                 FontSize="12"
                                                 Margin="0,0,0,6"
                                                 Background="{DynamicResource SurfaceBaseBrush}"
                                                 Foreground="{DynamicResource OnSurfaceBrush}"
                                                 BorderThickness="1"
                                                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                 CornerRadius="4"
                                                 Padding="6,4" />

                                        <!-- Test result: success -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding TestResult}"
                                                   IsVisible="{Binding TestSucceeded}"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SuccessBrush}" />

                                        <!-- Test result: failure -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding TestResult}"
                                                   IsVisible="{Binding TestFailed}"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}" />
                                    </Grid>

                                    <!-- Per-type setup help -->
                                    <Border Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource SurfaceOverlayBrush}">
                                        <TextBlock Text="{Binding HelpText}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource OnSurfaceMutedBrush}" />
                                    </Border>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save"
                                                Command="{Binding SaveCommand}"
                                                Padding="10,5"
                                                FontSize="11"
                                                Background="{DynamicResource SynthwavePurpleBrush}"
                                                Foreground="White"
                                                CornerRadius="4" />
                                        <Button Content="Test connection"
                                                Command="{Binding TestConnectionCommand}"
                                                IsEnabled="{Binding !IsTesting}"
                                                Padding="10,5"
                                                FontSize="11"
                                                Background="{DynamicResource SurfaceOverlayBrush}"
                                                Foreground="{DynamicResource OnSurfaceDimBrush}"
                                                CornerRadius="4" />
                                        <Button Content="Delete"
                                                Command="{Binding DeleteCommand}"
                                                Padding="10,5"
                                                FontSize="11"
                                                Background="{DynamicResource SurfaceBaseBrush}"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                CornerRadius="4" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
