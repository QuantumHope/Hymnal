<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             x:Class="Hymnal.Views.NotesView"
             x:DataType="vm:NotesViewModel"
             Background="{DynamicResource Cora.Surface.Panel}">

    <Panel>

        <!-- Empty state: shown when no chapter is active -->
        <TextBlock Text="{Binding EmptyStateText}"
                   IsVisible="{Binding ChapterTitle, Converter={x:Static ObjectConverters.IsNull}}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Cora.Text.Disabled}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="12"
                   Margin="16" />

        <!-- Notes text area -->
        <TextBox Text="{Binding Text, Mode=TwoWay}"
                 IsReadOnly="{Binding IsReadOnly}"
                 PlaceholderText="{Binding LoadError}"
                 IsVisible="{Binding ChapterTitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Background="{DynamicResource Cora.Surface.Void}"
                 Foreground="{DynamicResource Cora.Text}"
                 BorderThickness="0"
                 Padding="10"
                 FontSize="13"
                 FontFamily="{DynamicResource Cora.Font.Persona}"
                 VerticalAlignment="Stretch"
                 CaretBrush="{DynamicResource Cora.Accent.Store}"
                 VerticalContentAlignment="Top" />

    </Panel>

</UserControl>
