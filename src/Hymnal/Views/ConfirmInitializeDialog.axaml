<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hymnal.Views.ConfirmInitializeDialog"
        Title="Initialize project"
        Width="440" Height="180"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cora.Surface.Panel}"
        FontFamily="{DynamicResource Cora.Font.Persona}">

    <Border BorderBrush="{DynamicResource Cora.Border.Subtle}" BorderThickness="1" Padding="16">
        <StackPanel Spacing="16">
            <TextBlock Text="This folder isn't a Hymnal project yet. Initialize it?"
                       Foreground="{DynamicResource Cora.Text}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Initialize"
                        IsDefault="True"
                        Padding="12,6"
                        Background="{DynamicResource Cora.Accent.Store}"
                        Foreground="{DynamicResource Cora.IconInk}"
                        BorderThickness="0"
                        Click="InitializeButton_Click" />
                <Button Content="Cancel"
                        IsCancel="True"
                        Padding="12,6"
                        Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
