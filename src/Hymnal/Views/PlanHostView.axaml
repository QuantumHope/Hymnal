<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             x:Class="Hymnal.Views.PlanHostView"
             x:DataType="vm:PlanHostViewModel"
             Background="{DynamicResource Cora.Surface.Void}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Anthology: breadcrumb back to the collection while a story's board is shown -->
        <Border x:Name="Breadcrumb"
                Grid.Row="0"
                Padding="12,6"
                BorderBrush="{DynamicResource Cora.Border.Subtle}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding ShowBreadcrumb}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Padding="8,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource Cora.Accent.Store}"
                        ToolTip.Tip="Back to the collection"
                        Command="{Binding BackToCollectionCommand}">
                    <TextBlock Text="{Binding BreadcrumbParent, StringFormat='← {0}'}" />
                </Button>
                <TextBlock Text="›"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Cora.Text.Disabled}" />
                <TextBlock Text="{Binding BeatBoard.BoardTitle}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Cora.Text}" />
            </StackPanel>
        </Border>

        <ContentControl x:Name="PlanContent"
                        Grid.Row="1"
                        Content="{Binding Content}" />

        <!-- Short Story with several scene files: the file Corkboard, for reordering scenes -->
        <Expander x:Name="FilesStrip"
                  Grid.Row="2"
                  Header="Scene files"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding ShowFilesStrip}"
                  IsExpanded="{Binding IsFilesStripExpanded, Mode=TwoWay}">
            <ContentControl x:Name="FilesContent"
                            Height="280"
                            Content="{Binding FilesStripContent}" />
        </Expander>
    </Grid>
</UserControl>
