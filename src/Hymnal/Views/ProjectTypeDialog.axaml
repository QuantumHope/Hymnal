<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hymnal.ViewModels"
        xmlns:conv="using:Hymnal.Views.Converters"
        x:Class="Hymnal.Views.ProjectTypeDialog"
        x:DataType="vm:ProjectTypeDialogViewModel"
        Title="Choose project type"
        Width="780" Height="380"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#120932"
        FontFamily="{DynamicResource InterFont}">

    <Window.Styles>
        <Style Selector="Button.typeCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Width" Value="230" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.typeCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SynthwavePurpleBrush}" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#2D1B5E" BorderThickness="1" Padding="16">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                <Button Content="Create"
                        IsDefault="True"
                        Padding="12,6"
                        Background="{DynamicResource SynthwavePurpleBrush}"
                        Foreground="{DynamicResource OnSurfaceBrush}"
                        BorderThickness="0"
                        Command="{Binding CreateCommand}" />
                <Button Content="Cancel"
                        IsCancel="True"
                        Padding="12,6"
                        Click="CancelButton_Click" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectTypeCardViewModel">
                        <Button Classes="typeCard"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding $parent[Window].((vm:ProjectTypeDialogViewModel)DataContext).SelectCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Spacing="8">
                                <PathIcon Width="40" Height="40" HorizontalAlignment="Left"
                                          Foreground="{DynamicResource SynthwavePurpleBrush}"
                                          Data="{Binding Info.IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}" />
                                <TextBlock Text="{Binding Info.Title}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnSurfaceBrush}" />
                                <TextBlock Text="{Binding Info.Description}"
                                           Foreground="{DynamicResource OnSurfaceDimBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Info.Impact}" FontSize="12"
                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
