<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             x:Class="Hymnal.Views.CollectionShelf"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.shelf-header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ToggleButton.shelf-header:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.shelf-header:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.shelf-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Cora.Wash.Hover}" />
        </Style>
        <Style Selector="ToggleButton.shelf-header Path.chevron">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <Style Selector="ToggleButton.shelf-header:checked Path.chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>

        <Style Selector="Border.shelf-card">
            <Setter Property="Width" Value="230" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Border.Subtle}" />
            <Setter Property="Background" Value="{DynamicResource Cora.Surface.Elevated}" />
        </Style>
        <Style Selector="Border.shelf-card.openable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.shelf-card.openable:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Store}" />
            <Setter Property="Background" Value="{DynamicResource Cora.Wash.Hover}" />
        </Style>
        <Style Selector="Border.shelf-card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Merge}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Cora.Wash.Selected}" />
        </Style>
        <Style Selector="Border.shelf-card.new">
            <Setter Property="Width" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Border.Input}" />
        </Style>
        <Style Selector="Border.shelf-card.new:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Store}" />
            <Setter Property="Background" Value="{DynamicResource Cora.Wash.Hover}" />
        </Style>
        <Style Selector="TextBlock.story-line">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Cora.Text}" />
        </Style>
    </UserControl.Styles>

    <!-- Plan, for a workspace that can hold several collections: every collection side by side with its stories.
         The open one (whose stories the corkboard below shows) is highlighted; click another to open it. -->
    <Border Background="{DynamicResource Cora.Surface.Panel}"
            BorderBrush="{DynamicResource Cora.Border.Subtle}"
            BorderThickness="0,0,0,1">
        <DockPanel>
            <!-- The whole header shows or hides the shelf -->
            <ToggleButton x:Name="ShelfToggle"
                          DockPanel.Dock="Top"
                          Classes="shelf-header"
                          IsChecked="True"
                          ToolTip.Tip="Show or hide every collection">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Path Grid.Column="0"
                          Classes="chevron"
                          Data="M6 9l6 6 6-6"
                          Stroke="{DynamicResource Cora.Text.Secondary}"
                          StrokeThickness="1.6"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Width="10" Height="10"
                          Stretch="Uniform"
                          RenderTransformOrigin="50%,50%"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="caps"
                               Text="COLLECTIONS"
                               Margin="8,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                    <TextBlock Grid.Column="2"
                               Text="The open one is laid out below. Click another to open it."
                               Margin="14,0,0,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Cora.Text.Disabled}" />
                </Grid>
            </ToggleButton>

            <ScrollViewer IsVisible="{Binding #ShelfToggle.IsChecked}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,2,12,12">

                    <ItemsControl ItemsSource="{Binding CollectionsViewModel.Cards, FallbackValue={x:Null}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectionCard">
                                <Border Classes="shelf-card"
                                        Classes.active="{Binding IsActive}"
                                        Classes.openable="{Binding CanOpen}"
                                        Tapped="Card_Tapped"
                                        ToolTip.Tip="{Binding Title}">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Cora.Accent.Merge}" />
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsActive}"
                                                    Margin="6,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Cora.Accent.Merge}">
                                                <TextBlock Text="OPEN"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           LetterSpacing="1"
                                                           Foreground="{DynamicResource Cora.IconInk}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding CountText}"
                                                   FontSize="11"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource Cora.Text.Secondary}" />
                                        <ItemsControl ItemsSource="{Binding Stories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Classes="story-line" Text="{Binding StringFormat='• {0}'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding MoreText}"
                                                   IsVisible="{Binding HasMore}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Cora.Text.Secondary}" />
                                        <TextBlock Text="No stories yet"
                                                   IsVisible="{Binding IsEmpty}"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource Cora.Text.Disabled}" />
                                        <TextBlock Text="Name it (⋯) to open another"
                                                   IsVisible="{Binding !IsNamed}"
                                                   Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Cora.Text.Disabled}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Start another collection over the same folder of stories -->
                    <Border Classes="shelf-card new"
                            Tapped="NewCollection_Tapped"
                            ToolTip.Tip="Start another collection over the same folder of stories">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="+"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Cora.Accent.Store}" />
                            <TextBlock Text="New collection"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Cora.Text.Secondary}" />
                        </StackPanel>
                    </Border>

                    <!-- Story files no collection lists -->
                    <Border Classes="shelf-card"
                            IsVisible="{Binding CollectionsViewModel.HasUnassigned, FallbackValue=False}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="In no collection"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Cora.Text.Secondary}" />
                            <TextBlock Text="Add a story to the open collection"
                                       FontSize="11"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource Cora.Text.Disabled}" />
                            <ItemsControl ItemsSource="{Binding CollectionsViewModel.Unassigned, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Classes="story-line"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding}" />
                                            <Button Grid.Column="1"
                                                    Content="Add"
                                                    FontSize="10"
                                                    Padding="6,1"
                                                    MinHeight="0"
                                                    Margin="6,1,0,1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Foreground="{DynamicResource Cora.Accent.Store}"
                                                    Click="AddUnassigned_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
