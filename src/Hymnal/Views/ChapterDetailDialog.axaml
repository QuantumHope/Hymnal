<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hymnal.ViewModels"
        xmlns:views="clr-namespace:Hymnal.Views"
        x:Class="Hymnal.Views.ChapterDetailDialog"
        x:DataType="vm:ChapterDetailViewModel"
        Title="{Binding ChapterTitle}"
        Width="380" Height="580"
        MinWidth="320" MinHeight="400"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cora.Surface.Void}"
        FontFamily="{DynamicResource Cora.Font.Persona}">

    <Grid RowDefinitions="5,Auto,*,Auto">

        <!-- Synthwave accent stripe -->
        <Border Grid.Row="0" Height="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="{DynamicResource Cora.Accent.Store.Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource Cora.Accent.Merge.Color}" Offset="0.5" />
                    <GradientStop Color="{DynamicResource Cora.Accent.Retrieve.Color}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Header -->
        <Border Grid.Row="1"
                Background="{DynamicResource Cora.Surface.Panel}"
                BorderBrush="{DynamicResource Cora.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding ChapterTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Cora.Text}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="caps" Text="Details"
                           FontSize="10"
                           LetterSpacing="1.5"
                           Foreground="{DynamicResource Cora.Text.Secondary}" />
            </StackPanel>
        </Border>

        <!-- Reusable chapter info widget -->
        <views:ChapterInfoWidget Grid.Row="2"
                                 DataContext="{Binding}" />

        <!-- Footer with close button -->
        <Border Grid.Row="3"
                Background="{DynamicResource Cora.Surface.Panel}"
                BorderBrush="{DynamicResource Cora.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Button Content="Close"
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right"
                    Padding="20,6"
                    CornerRadius="4"
                    Background="{DynamicResource Cora.Wash.Selected}"
                    Foreground="{DynamicResource Cora.Text}"
                    BorderThickness="0"
                    FontSize="12" />
        </Border>

    </Grid>

</Window>
