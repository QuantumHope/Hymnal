<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hymnal.Views.AboutDialog"
        Title="About Hymnal"
        Width="400" Height="340"
        Icon="/Assets/hymnal.ico"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cora.Surface.Void}"
        FontFamily="{DynamicResource Cora.Font.Persona}">

    <Grid RowDefinitions="5,*">
        <!-- Accent stripe -->
        <Border Grid.Row="0" Height="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="{DynamicResource Cora.Accent.Store.Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource Cora.Accent.Merge.Color}" Offset="0.5" />
                    <GradientStop Color="{DynamicResource Cora.Accent.Retrieve.Color}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="32">

            <Image Source="/Assets/hymnal-256.png"
                   Width="88" Height="88"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   HorizontalAlignment="Center" />

            <TextBlock Text="Hymnal"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Cora.Accent.Store}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="A streamlined editor for authors to plan, write, review, and edit LeanPub / Markua style manuscripts."
                       FontSize="13"
                       Foreground="{DynamicResource Cora.Text.Secondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="300" />

            <TextBlock Text="Created by Matthew Hope-Eland"
                       FontSize="12"
                       Foreground="{DynamicResource Cora.Text.Disabled}"
                       HorizontalAlignment="Center" />

            <Button Content="Close"
                    HorizontalAlignment="Center"
                    Padding="20,6"
                    CornerRadius="4"
                    Background="{DynamicResource Cora.Wash.Selected}"
                    Foreground="{DynamicResource Cora.Text}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>

</Window>
