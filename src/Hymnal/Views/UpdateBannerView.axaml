<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:upd="using:MattEland.HopeLab.Updates.ReactiveUI"
             x:Class="Hymnal.Views.UpdateBannerView"
             x:DataType="upd:UpdatesViewModel">

    <!-- A new release, until it is installed or dismissed for that version (UpdatesViewModel.ShowBanner). -->
    <Border x:Name="PART_UpdateBanner"
            IsVisible="{Binding ShowBanner, FallbackValue=False}"
            Background="#1A0F38"
            BorderBrush="{DynamicResource SynthwavePurpleBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Download arrow in the accent pink -->
            <Path Grid.Column="0"
                  Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20"
                  Width="20" Height="20"
                  Stretch="Uniform"
                  VerticalAlignment="Top"
                  Margin="0,2,0,0"
                  Stroke="{DynamicResource PinkBrush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
            <StackPanel Grid.Column="1" Margin="12,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="PART_BannerTitle"
                           Text="{Binding BannerTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrightBrush}" />
                <TextBlock Text="{Binding BannerBody}"
                           IsVisible="{Binding !Installing}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OnSurfaceDimBrush}" />
                <TextBlock Text="{Binding Progress}"
                           IsVisible="{Binding Installing}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OnSurfaceDimBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Not now"
                        Command="{Binding DismissCommand}"
                        Padding="12,6"
                        FontSize="12"
                        CornerRadius="5" />
                <Button Content="What's new"
                        Command="{Binding OpenReleaseNotesCommand}"
                        Padding="12,6"
                        FontSize="12"
                        CornerRadius="5" />
                <Button x:Name="PART_InstallButton"
                        Content="{Binding InstallLabel}"
                        Command="{Binding InstallCommand}"
                        Padding="12,6"
                        FontSize="12"
                        CornerRadius="5"
                        Background="{DynamicResource SynthwavePurpleBrush}"
                        Foreground="White" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
