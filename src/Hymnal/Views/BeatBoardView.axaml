<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             xmlns:controls="using:Hymnal.Views.Controls"
             x:Class="Hymnal.Views.BeatBoardView"
             x:Name="Root"
             x:DataType="vm:BeatBoardViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource Cora.Surface.Void}">

    <UserControl.Styles>
        <Style Selector="ListBox#BeatList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#BeatList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#BeatList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.beat-card">
            <Setter Property="Background" Value="{DynamicResource Cora.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="ListBox#BeatList ListBoxItem:selected Border.beat-card">
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Store}" />
        </Style>
        <Style Selector="Border.beat-card.drop-target">
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Store}" />
            <Setter Property="BorderThickness" Value="1,3,1,1" />
        </Style>
        <Style Selector="Border.template-card">
            <Setter Property="Background" Value="{DynamicResource Cora.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.template-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Store}" />
        </Style>
        <Style Selector="Border.template-thumbnail">
            <Setter Property="Height" Value="120" />
            <Setter Property="Background" Value="{DynamicResource Cora.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.beat-count">
            <Setter Property="Background" Value="{DynamicResource Cora.Border.Subtle}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.template-primary">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="{DynamicResource Cora.Accent.Store}" />
            <Setter Property="Foreground" Value="{DynamicResource Cora.Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource Cora.Text.Secondary}" />
        </Style>
        <Style Selector="Button.beat-action">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cora.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource Cora.Accent.Store}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header: board title and board-wide actions -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource Cora.Border.Subtle}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Classes="caps" DockPanel.Dock="Left"
                           Text="BEATS"
                           VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           LetterSpacing="1.5"
                           Foreground="{DynamicResource Cora.Text.Secondary}" />
                <TextBlock DockPanel.Dock="Left"
                           Margin="12,0,0,0"
                           Text="{Binding BoardTitle}"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Cora.Text}" />
                <Button x:Name="ApplyTemplateButton"
                        DockPanel.Dock="Right"
                        Classes="beat-action"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Add a template's beats to this board, or replace them"
                        Command="{Binding ChooseTemplateCommand}"
                        IsVisible="{Binding ShowsBeats}">
                    <TextBlock Text="Apply template…" />
                </Button>
                <Button x:Name="BackToBeatsButton"
                        DockPanel.Dock="Right"
                        Classes="beat-action"
                        Margin="8,0,0,0"
                        Content="← Back to beats"
                        Command="{Binding CancelTemplateChoiceCommand}"
                        IsVisible="{Binding IsChoosingTemplate}" />
                <Button DockPanel.Dock="Right"
                        Content="+ Add beat"
                        Padding="12,4"
                        Background="{DynamicResource Cora.Accent.Store}"
                        Foreground="{DynamicResource Cora.IconInk}"
                        BorderThickness="0"
                        ToolTip.Tip="Add a beat after the selected one"
                        IsVisible="{Binding !IsChoosingTemplate}"
                        Command="{Binding AddBeatCommand}" />
            </DockPanel>
        </Border>

        <Border x:Name="ReadOnlyBanner"
                Grid.Row="1"
                Padding="16,8"
                Background="{DynamicResource Cora.Wash.Warning}"
                IsVisible="{Binding IsReadOnly}">
            <TextBlock Text="This beat board's file couldn't be read, so the board is read-only. Fix or remove the file, then reopen the project to edit it."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource Cora.Accent.Unknown}" />
        </Border>

        <!-- Template gallery: an empty board starts from one; Apply template adds to or replaces the beats -->
        <ScrollViewer x:Name="TemplatePickerPanel"
                      Grid.Row="2"
                      Padding="20,16"
                      IsVisible="{Binding ShowsTemplatePicker}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4" IsVisible="{Binding !IsChoosingTemplate}">
                    <TextBlock Text="How will this story unfold?"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Cora.Text}" />
                    <TextBlock Text="Pick a shape to start from. You can rename, rewrite, reorder or delete every beat later."
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Cora.Text.Disabled}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding IsChoosingTemplate}">
                    <TextBlock Text="Apply a template"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Cora.Text}" />
                    <TextBlock Text="Add a template's beats after the ones you have, or replace them all."
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Cora.Text.Disabled}" />
                </StackPanel>
                <ItemsControl x:Name="TemplatePicker"
                              ItemsSource="{Binding TemplateOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BeatTemplateOptionViewModel">
                            <Border Classes="template-card">
                                <StackPanel>
                                    <Border Classes="template-thumbnail">
                                        <controls:BeatShapeThumbnail Levels="{Binding Shape}" />
                                    </Border>
                                    <StackPanel Margin="16,12,16,16" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Cora.Text}" />
                                            <Border Grid.Column="1" Classes="beat-count">
                                                <TextBlock Text="{Binding BeatCountLabel}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Cora.Text}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Cora.Text.Disabled}" />
                                        <ItemsControl ItemsSource="{Binding BeatPreview}"
                                                      IsVisible="{Binding CanAppend}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               Margin="0,1"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Cora.Text.Secondary}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    IsVisible="{Binding HasParameter}">
                                            <TextBlock Text="{Binding ParameterLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Cora.Text.Disabled}" />
                                            <ComboBox ItemsSource="{Binding ParameterOptions}"
                                                      SelectedItem="{Binding SelectedParameter, Mode=TwoWay}" />
                                        </StackPanel>

                                        <!-- Starting an empty board -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    IsVisible="{Binding !DataContext.IsChoosingTemplate, ElementName=Root}">
                                            <Button Classes="template-primary"
                                                    Content="Use this template"
                                                    IsVisible="{Binding CanAppend}"
                                                    Command="{Binding DataContext.ApplyTemplateCommand, ElementName=Root}"
                                                    CommandParameter="{Binding AppendRequest}" />
                                            <Button Classes="template-primary"
                                                    Content="Start blank"
                                                    ToolTip.Tip="Start with one empty beat"
                                                    IsVisible="{Binding IsBlank}"
                                                    Command="{Binding DataContext.AddBeatCommand, ElementName=Root}" />
                                        </StackPanel>

                                        <!-- Applying to a board that already has beats -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    IsVisible="{Binding DataContext.IsChoosingTemplate, ElementName=Root}">
                                            <Button Classes="template-primary"
                                                    Content="Add to end"
                                                    ToolTip.Tip="Add this template's beats after the current ones"
                                                    IsVisible="{Binding CanAppend}"
                                                    Command="{Binding DataContext.ApplyTemplateCommand, ElementName=Root}"
                                                    CommandParameter="{Binding AppendRequest}" />
                                            <Button Classes="beat-action"
                                                    Content="Replace all"
                                                    ToolTip.Tip="Replace every beat on this board (asks first)"
                                                    IsVisible="{Binding CanAppend}"
                                                    Command="{Binding DataContext.ApplyTemplateCommand, ElementName=Root}"
                                                    CommandParameter="{Binding ReplaceRequest}" />
                                            <Button Classes="beat-action"
                                                    Content="Clear all beats"
                                                    ToolTip.Tip="Delete every beat on this board (asks first)"
                                                    IsVisible="{Binding IsBlank}"
                                                    Command="{Binding DataContext.ApplyTemplateCommand, ElementName=Root}"
                                                    CommandParameter="{Binding ReplaceRequest}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Ordered beat cards -->
        <ListBox x:Name="BeatList"
                 Grid.Row="2"
                 Padding="16"
                 Background="Transparent"
                 IsVisible="{Binding ShowsBeats}"
                 ItemsSource="{Binding Beats}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:BeatCardViewModel">
                    <Border Classes="beat-card"
                            Loaded="BeatCard_Loaded">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Classes="beat-drag-handle"
                                       Text="⠿"
                                       FontSize="16"
                                       Cursor="SizeAll"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0"
                                       ToolTip.Tip="Drag to reorder"
                                       Foreground="{DynamicResource Cora.Text.Disabled}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBox Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="Beat title"
                                         IsReadOnly="{Binding !DataContext.CanEdit, ElementName=Root}"
                                         FontSize="14"
                                         FontWeight="SemiBold" />
                                <TextBox Text="{Binding Note, Mode=TwoWay}"
                                         PlaceholderText="What happens in this beat?"
                                         IsReadOnly="{Binding !DataContext.CanEdit, ElementName=Root}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="48" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            IsVisible="{Binding DataContext.ShowsSceneLinks, ElementName=Root}">
                                    <TextBlock Classes="field-label"
                                               Text="SCENE"
                                               VerticalAlignment="Center" />
                                    <ComboBox MinWidth="200"
                                              IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}"
                                              PlaceholderText="Missing scene"
                                              ItemsSource="{Binding SceneChoices}"
                                              SelectedItem="{Binding SelectedScene, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="vm:SceneOption">
                                                <TextBlock Text="{Binding Title}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource Cora.Text.Disabled}"
                                               Text="{Binding SceneStatusLabel}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource Cora.Text.Disabled}"
                                               Text="{Binding SceneWordCount, StringFormat='{}{0:N0} words'}" />
                                </StackPanel>
                                <TextBlock IsVisible="{Binding IsSceneMissing}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Cora.Accent.Unknown}"
                                           Text="{Binding SceneTitle, StringFormat='Linked scene {0} is no longer in the story. Choose None to unlink it.'}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="beat-action"
                                    VerticalAlignment="Top"
                                    Content="Delete"
                                    ToolTip.Tip="Delete this beat (asks first)"
                                    Command="{Binding DataContext.DeleteBeatCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
