<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             xmlns:models="using:Hymnal.Core.Models"
             xmlns:conv="using:Hymnal.Views.Converters"
             xmlns:controls="using:Hymnal.Views.Controls"
             x:Class="Hymnal.Views.SidebarView"
             x:DataType="vm:WorkspaceViewModel"
             Background="{DynamicResource Cora.Surface.Panel}">

    <UserControl.Resources>
        <conv:NodeKindToFontWeightConverter x:Key="NodeKindToFontWeightConverter" />
        <conv:NodeKindToMarginConverter x:Key="NodeKindToMarginConverter" />
        <conv:NodeKindToForegroundConverter x:Key="NodeKindToForegroundConverter" />
        <conv:NodeKindAndMissingToForegroundConverter x:Key="NodeKindAndMissingToForegroundConverter" />
        <conv:NodeKindIsChapterConverter x:Key="NodeKindIsChapterConverter" />
        <conv:NodeKindIsPartConverter x:Key="NodeKindIsPartConverter" />
        <conv:NodeKindIsChapterAndPresentConverter x:Key="NodeKindIsChapterAndPresentConverter" />
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <conv:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter" />
        <conv:BoolNotConverter x:Key="BoolNotConverter" />
        <conv:StatusEqualsConverter x:Key="StatusEqualsConverter" />
        <conv:StatusDotTooltipConverter x:Key="StatusDotTooltipConverter" />
        <conv:NullableIntToStringConverter x:Key="NullableIntToStringConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.status-icon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.status-icon-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Cora.Surface.Elevated}" />
        </Style>
        <Style Selector="Button.status-icon-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Cora.Wash.Selected}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Empty state: shown when no workspace is loaded -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding !HasWorkspace}">

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Cora.Accent.Error}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="180"
                       FontSize="11"
                       TextAlignment="Center" />

            <TextBlock Text="No workspace open"
                       Foreground="{DynamicResource Cora.Text.Disabled}"
                       HorizontalAlignment="Center"
                       FontSize="12" />

            <Button Content="Open Folder…"
                    Command="{Binding OpenWorkspaceCommand}"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Cora.Accent.Store}"
                    Foreground="{DynamicResource Cora.Text}"
                    Padding="12,6"
                    CornerRadius="4" />
        </StackPanel>

        <!-- Workspace content: CHAPTERS header + chapter tree -->
        <DockPanel IsVisible="{Binding HasWorkspace}" LastChildFill="True">

            <!-- Book root row (selectable — opens Book.txt in editor) -->
            <Button DockPanel.Dock="Top"
                    Command="{Binding SelectBookCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,6"
                    Margin="4,4,4,0"
                    CornerRadius="4"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Cora.Wash.Selected}" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Cora.Surface.Elevated}" />
                    </Style>
                </Button.Styles>
                <!-- 3-column grid matching the list items so word counts align -->
                <Grid ColumnDefinitions="*,60,30">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Profile.CollectionNoun}"
                               Foreground="{DynamicResource Cora.Accent.Merge}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding WorkspaceName}" />
                        </ToolTip.Tip>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalWordCountDisplay}"
                               Foreground="{DynamicResource Cora.Text.Disabled}"
                               FontSize="11"
                               TextAlignment="Right"
                               VerticalAlignment="Center">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding TotalWordCountTooltip}" />
                        </ToolTip.Tip>
                    </TextBlock>
                    <controls:StatusPieChart Grid.Column="2"
                                            Segments="{Binding BookStatusSummary}"
                                            Width="18" Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Chapter tree -->
            <ListBox ItemsSource="{Binding VisibleNodes}"
                     SelectedItem="{Binding SelectedNode}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,4">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource Cora.Text}" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Margin" Value="4,1" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Cora.Wash.Selected}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Cora.Wash.Selected}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="BorderBrush" Value="{DynamicResource Cora.Accent.Store}" />
                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                        <Setter Property="CornerRadius" Value="0,4,4,0" />
                        <Setter Property="Padding" Value="6,5" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ChapterViewModel">
                        <Panel>
                            <Border Name="InsertBefore"
                                    Height="2"
                                    Background="{DynamicResource Cora.Accent.Store}"
                                    IsVisible="False"
                                    VerticalAlignment="Top"
                                    ZIndex="10" />
                        <Grid ColumnDefinitions="*,60,30"
                              Loaded="ChapterRow_Loaded">

                            <!-- Right-click context menu -->
                            <Grid.ContextMenu>
                                <ContextMenu Opened="ChapterContextMenu_Opened">
                                    <MenuItem Name="RenameMenuItem"
                                              Header="Rename…"
                                              Click="RenameNode_Click" />
                                    <Separator Name="RenameSeparator" />
                                    <MenuItem Header="Mark complete"
                                              IsVisible="{Binding Node.Kind, Converter={StaticResource NodeKindIsChapterConverter}}"
                                              Command="{Binding CompletePhaseCommand}" />
                                    <MenuItem Header="Set Target…"
                                              IsVisible="{Binding CanSetTarget}"
                                              Command="{Binding OpenTargetFlyoutCommand}" />
                                    <Separator IsVisible="{Binding Node.Kind, Converter={StaticResource NodeKindIsChapterConverter}}" />
                                    <MenuItem Header="{Binding Profile.IncludeInCollectionLabel}"
                                              IsVisible="{Binding Node.IsExcluded}"
                                              Click="IncludeInBook_Click" />
                                    <MenuItem Header="{Binding Profile.ExcludeFromCollectionLabel}"
                                              Click="ExcludeFromBook_Click">
                                        <MenuItem.IsVisible>
                                            <MultiBinding Converter="{StaticResource NodeKindIsChapterAndPresentConverter}">
                                                <Binding Path="Node.Kind" />
                                                <Binding Path="Node.IsMissing" />
                                                <Binding Path="Node.IsExcluded" />
                                            </MultiBinding>
                                        </MenuItem.IsVisible>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding Node.IsMissing}" />
                                    <MenuItem Header="Remove"
                                              IsVisible="{Binding Node.IsMissing}"
                                              Click="RemoveFromBook_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <!-- Title + proximity fill bar [Col 0] -->
                            <Grid Grid.Column="0" ColumnDefinitions="20,*">
                                <!-- Chevron toggle (Part nodes only) -->
                                <Button Grid.Column="0"
                                        IsVisible="{Binding Node.Kind, Converter={StaticResource NodeKindIsPartConverter}}"
                                        Command="{Binding ToggleExpandedCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="16" Height="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand">
                                    <Grid Width="12" Height="12">
                                        <TextBlock Text="▼"
                                                   IsVisible="{Binding IsExpanded}"
                                                   FontSize="8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Cora.Text.Secondary}" />
                                        <TextBlock Text="▶"
                                                   IsVisible="{Binding IsExpanded, Converter={StaticResource BoolNotConverter}}"
                                                   FontSize="8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Cora.Text.Secondary}" />
                                    </Grid>
                                </Button>

                                <!-- Title + proximity fill bar -->
                                <StackPanel Grid.Column="1" Spacing="0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Node.Title}"
                                                   FontWeight="{Binding Node.Kind, Converter={StaticResource NodeKindToFontWeightConverter}}"
                                                   FontStyle="{Binding Node.IsExcluded, Converter={StaticResource BoolToFontStyleConverter}}"
                                                   Margin="{Binding Node.Kind, Converter={StaticResource NodeKindToMarginConverter}}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource NodeKindAndMissingToForegroundConverter}">
                                                    <Binding Path="Node.Kind" />
                                                    <Binding Path="Node.IsMissing" />
                                                    <Binding Path="Node.IsExcluded" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding Node.IsExcluded}"
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                CornerRadius="4"
                                                Background="{DynamicResource Cora.Wash.Selected}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="excluded"
                                                       Foreground="{DynamicResource Cora.Text.Secondary}"
                                                       FontSize="10"
                                                       FontStyle="Italic"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <!-- Proximity fill bar: visible only when chapter has a target -->
                                    <ProgressBar IsVisible="{Binding HasTarget}"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 Value="{Binding ProximityFill}"
                                                 Height="2"
                                                 Margin="0,3,4,0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource Cora.Accent.Store}"
                                                 Opacity="0.4"
                                                 VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>

                            <!-- Word count / Part total + target popup anchor [Col 1] -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="0">

                                <!-- Chapter word count (chapter nodes only) -->
                                <TextBlock Text="{Binding WordCountDisplay}"
                                           IsVisible="{Binding Node.Kind, Converter={StaticResource NodeKindIsChapterConverter}}"
                                           Foreground="{DynamicResource Cora.Text.Disabled}"
                                           FontSize="11"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding WordCountTooltip}" />
                                    </ToolTip.Tip>
                                </TextBlock>

                                <!-- Part total (Part nodes only) -->
                                <TextBlock Text="{Binding PartTotalDisplay}"
                                           IsVisible="{Binding Node.Kind, Converter={StaticResource NodeKindIsPartConverter}}"
                                           Foreground="{DynamicResource Cora.Text.Disabled}"
                                           FontSize="11"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding PartTotalTooltip}" />
                                    </ToolTip.Tip>
                                </TextBlock>

                            </StackPanel>

                            <!-- Status pie chart for Part nodes [Col 2] -->
                            <controls:StatusPieChart Grid.Column="2"
                                                     IsVisible="{Binding Node.Kind, Converter={StaticResource NodeKindIsPartConverter}}"
                                                     Segments="{Binding PartStatusSummary}"
                                                     Width="18" Height="18"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />

                            <!-- Status button [Col 2] -->
                            <Button Grid.Column="2"
                                    Classes="status-icon-button"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand">
                                <Button.IsVisible>
                                    <Binding Path="Node.Kind" Converter="{StaticResource NodeKindIsChapterConverter}" />
                                </Button.IsVisible>
                                <ToolTip.Tip>
                                    <Panel>
                                        <!-- Missing file case -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding Node.IsMissing}">
                                            <Path Data="M12 2L2 20h20L12 2zm0 5.5L18.25 18H5.75L12 7.5zm-1 4.5h2v4h-2zm0 5.2h2v2h-2z"
                                                  Fill="{DynamicResource Cora.Accent.Unknown}"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="File not found"
                                                       Foreground="{DynamicResource Cora.Accent.Unknown}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Normal status case -->
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Node.IsMissing, Converter={StaticResource BoolNotConverter}}">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="{DynamicResource Cora.Text}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Click to change status"
                                                           Foreground="{DynamicResource Cora.Text.Secondary}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </ToolTip.Tip>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Planned}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Planned}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Planned}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Accent.Unknown}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Outlining}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Outlining}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Outlining}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Text.Secondary}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Drafting}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Drafting}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Drafting}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Accent.Retrieve}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Editing}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Editing}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Editing}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Accent.Store}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Polishing}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Polishing}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Polishing}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Accent.Create}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Reviewing}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Reviewing}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Reviewing}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Accent.Merge}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding Profile, Converter={x:Static conv:ProfileStatusLabelConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Done}}"
                                                  IsVisible="{Binding Profile, Converter={x:Static conv:ProfileShowsStatusConverter.Instance}, ConverterParameter={x:Static models:ChapterStatus.Done}}"
                                                  Command="{Binding ChangeStatusCommand}"
                                                  CommandParameter="{x:Static models:ChapterStatus.Done}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource Cora.Accent.Success}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Grid Width="22" Height="22">
                                    <Ellipse Width="8" Height="8"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding Node.IsMissing, Converter={StaticResource BoolNotConverter}}"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                    <Path IsVisible="{Binding Node.IsMissing}"
                                          Data="M12 2L2 20h20L12 2zm0 5.5L18.25 18H5.75L12 7.5zm-1 4.5h2v4h-2zm0 5.2h2v2h-2z"
                                          Fill="{DynamicResource Cora.Accent.Unknown}"
                                          Width="16" Height="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                        </Grid>
                            <Border Name="InsertAfter"
                                    Height="2"
                                    Background="{DynamicResource Cora.Accent.Store}"
                                    IsVisible="False"
                                    VerticalAlignment="Bottom"
                                    ZIndex="10" />
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Shared target flyout — one Popup for the entire sidebar instead of one per row -->
        <Popup IsOpen="{Binding IsTargetFlyoutOpen, Mode=TwoWay}"
               IsLightDismissEnabled="True"
               Placement="Pointer">
            <Border DataContext="{Binding TargetFlyoutChapter}"
                    Background="{DynamicResource Cora.Surface.Panel}"
                    BorderBrush="{DynamicResource Cora.Border.Input}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel Spacing="8" MinWidth="210">
                    <TextBlock Text="Set word count target"
                               Foreground="{DynamicResource Cora.Text}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasTargetPresets}">
                        <TextBlock Text="Length"
                                   Width="72"
                                   Foreground="{DynamicResource Cora.Text.Secondary}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding TargetPresets}"
                                  SelectedItem="{Binding PendingPreset, Mode=TwoWay}"
                                  Width="130"
                                  FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TargetPreset">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Min words"
                                   Width="72"
                                   Foreground="{DynamicResource Cora.Text.Secondary}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding PendingMinWords, Converter={StaticResource NullableIntToStringConverter}, Mode=TwoWay}"
                                 Width="90"
                                 Padding="6,3"
                                 FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Max words"
                                   Width="72"
                                   Foreground="{DynamicResource Cora.Text.Secondary}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding PendingMaxWords, Converter={StaticResource NullableIntToStringConverter}, Mode=TwoWay}"
                                 Width="90"
                                 Padding="6,3"
                                 FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                        <Button Content="Set"
                                Command="{Binding ConfirmTargetCommand}"
                                Background="{DynamicResource Cora.Accent.Store}"
                                Foreground="{DynamicResource Cora.Text}"
                                Padding="10,4" />
                        <Button Content="Clear"
                                Command="{Binding ClearTargetCommand}"
                                Padding="10,4" />
                        <Button Content="Cancel"
                                Command="{Binding CancelTargetFlyoutCommand}"
                                Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Loading overlay -->
        <Border IsVisible="{Binding IsLoading}"
                Background="{DynamicResource Cora.Surface.Panel}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="Loading…"
                           Foreground="{DynamicResource Cora.Text.Secondary}"
                           HorizontalAlignment="Center"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Panel>

</UserControl>
