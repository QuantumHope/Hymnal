<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             xmlns:avedit="using:AvaloniaEdit"
             xmlns:editor="using:Hymnal.Views.Editor"
             xmlns:conv="using:Hymnal.Views.Converters"
             xmlns:views="using:Hymnal.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Hymnal.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Background="Transparent">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="ToggleButton.view-mode">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceDimBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
        <Style Selector="ToggleButton.view-mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-mode:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D1B5E" />
            <Setter Property="Foreground" Value="#E9D5FF" />
        </Style>
        <Style Selector="ToggleButton.view-mode Path.view-icon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}" />
        </Style>
        <Style Selector="ToggleButton.view-mode:checked Path.view-icon">
            <Setter Property="Stroke" Value="#E9D5FF" />
        </Style>
        <Style Selector="ToggleButton.view-mode:pointerover Path.view-icon">
            <Setter Property="Stroke" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>
        <Style Selector="ToggleButton.view-mode TextBlock.view-label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Narrow editor column: icons only (the tooltips still name each mode). -->
        <Style Selector="Border.compact ToggleButton.view-mode TextBlock.view-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.compact ToggleButton.view-mode">
            <Setter Property="Padding" Value="7,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Conflict strip: visible when an external file change conflicts with dirty buffer -->
        <Border Grid.Row="0"
                IsVisible="{Binding HasConflict}"
                Background="{DynamicResource SurfaceHighBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding ConflictMessage}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="600" />
                <Button Content="Keep my edits"
                        Command="{Binding KeepLocalCommand}"
                        Padding="10,4"
                        CornerRadius="4" />
                <Button Content="Reload from disk"
                        Command="{Binding AcceptExternalCommand}"
                        Padding="10,4"
                        CornerRadius="4" />
            </StackPanel>
        </Border>

        <!-- Book.txt warning banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding ShowBookTxtWarning}"
                Background="#1A9D4EDD"
                BorderBrush="{DynamicResource SynthwavePurpleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Data="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      Stroke="{DynamicResource SynthwavePurpleBrush}"
                      StrokeThickness="1.5"
                      StrokeLineCap="Round"
                      Width="18" Height="18"
                      Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Text="Editing Book.txt — this file defines the chapter list. Save (Ctrl+S) to refresh the sidebar."
                           Foreground="{DynamicResource OnSurfaceDimBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Editor header: the host's HeaderContent (Write mode: the chapter status bar) on the left, the
             Write / Split / Preview switch (F6 cycles; hidden for Book.txt) on the right. One row, not two. -->
        <Border x:Name="PART_HeaderRow"
                Grid.Row="2"
                Height="36"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <ContentPresenter x:Name="PART_HeaderPresenter"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Content="{Binding $parent[views:EditorView].HeaderContent}" />

                <Border x:Name="PART_HeaderDivider"
                        Grid.Column="1"
                        Width="1"
                        Height="18"
                        Margin="10,0"
                        Background="{DynamicResource BorderDefaultBrush}" />

                <StackPanel x:Name="PART_ViewModeSwitch"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="2"
                            IsVisible="{Binding IsPreviewAvailable}">
                    <ToggleButton x:Name="PART_WriteModeButton"
                                  Classes="view-mode"
                                  ToolTip.Tip="Write: Markua source only (F6 cycles modes)"
                                  Command="{Binding SetViewModeCommand}"
                                  CommandParameter="{x:Static vm:EditorViewMode.Write}"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={x:Static conv:ShellModeEqualsConverter.Instance}, ConverterParameter=Write}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="view-icon" Data="{StaticResource Icon.ViewWrite}" />
                            <TextBlock Classes="view-label" Text="WRITE" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="PART_SplitModeButton"
                                  Classes="view-mode"
                                  ToolTip.Tip="Split: source beside the Leanpub preview (F6 cycles modes)"
                                  Command="{Binding SetViewModeCommand}"
                                  CommandParameter="{x:Static vm:EditorViewMode.Split}"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={x:Static conv:ShellModeEqualsConverter.Instance}, ConverterParameter=Split}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="view-icon" Data="{StaticResource Icon.ViewSplit}" />
                            <TextBlock Classes="view-label" Text="SPLIT" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="PART_PreviewModeButton"
                                  Classes="view-mode"
                                  ToolTip.Tip="Preview: the chapter as Leanpub sets it (F6 cycles modes)"
                                  Command="{Binding SetViewModeCommand}"
                                  CommandParameter="{x:Static vm:EditorViewMode.Preview}"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={x:Static conv:ShellModeEqualsConverter.Instance}, ConverterParameter=Preview}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="view-icon" Data="{StaticResource Icon.ViewPreview}" />
                            <TextBlock Classes="view-label" Text="PREVIEW" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
          <Grid x:Name="PART_PaneGrid" ColumnDefinitions="*,Auto,0">
            <avedit:TextEditor x:Name="PART_Editor"
                               Grid.Column="0"
                               IsVisible="{Binding ShowSourcePane}"
                               FontFamily="{DynamicResource EditorFont}"
                               FontSize="14"
                               WordWrap="True"
                               ShowLineNumbers="False"
                               Background="Transparent"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Auto"
                               Padding="16,12" />

            <GridSplitter x:Name="PART_PreviewSplitter"
                          Grid.Column="1"
                          Width="4"
                          IsVisible="{Binding IsSplitView}"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderSubtleBrush}" />

            <editor:MarkuaPreviewView x:Name="PART_Preview"
                                      Grid.Column="2"
                                      IsVisible="{Binding ShowPreviewPane}"
                                      Document="{Binding PreviewDocument}"
                                      BaseDirectory="{Binding PreviewBaseDirectory}" />
          </Grid>

            <Border IsVisible="{Binding ShowWorkspacePrompt}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="420">
                    <TextBlock Text="Open a workspace"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="Use File > Open Workspace or the sidebar button to load a manuscript."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceDimBrush}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowNoChapterPrompt}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="420">
                    <TextBlock Text="No chapter open"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="Select a chapter in the sidebar to load its Markua content here."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceDimBrush}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowNoResearchDocPrompt}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="420">
                    <TextBlock Text="No research doc open"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="Select a file in the DOCS sidebar, or create or import one to begin."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceDimBrush}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowMissingChapterPrompt}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="460">
                    <Path Data="M12 2L2 20h20L12 2zm0 5.5L18.25 18H5.75L12 7.5zm-1 4.5h2v4h-2zm0 5.2h2v2h-2z"
                          Fill="{DynamicResource OrangeBrush}"
                          Width="40" Height="40"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" />
                    <TextBlock Text="Chapter not found on disk"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="{Binding MissingChapterMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceDimBrush}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</UserControl>
