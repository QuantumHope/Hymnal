<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hymnal.ViewModels"
             xmlns:conv="using:Hymnal.Views.Converters"
             x:Class="Hymnal.Views.EditorChapterBar"
             x:DataType="vm:ChapterViewModel"
             Height="32">
    <!-- Hosted in EditorView's header row, which supplies the background and bottom border. -->

    <Grid ColumnDefinitions="Auto,*,Auto"
          Margin="12,0">
        <Border Grid.Column="0"
                Background="{DynamicResource Cora.Surface.Elevated}"
                CornerRadius="4"
                Padding="8,3"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="8"
                        Height="8"
                        CornerRadius="2"
                        Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Cora.Text.Secondary}"
                       VerticalAlignment="Center">
                <Run Text="Start " />
                <Run Text="{Binding CurrentPhaseStartDisplay}" Foreground="{DynamicResource Cora.Text}" />
            </TextBlock>
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Cora.Text.Secondary}"
                       VerticalAlignment="Center">
                <Run Text="End " />
                <Run Text="{Binding CurrentPhaseEndDisplay}" Foreground="{DynamicResource Cora.Text}" />
            </TextBlock>
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Cora.Text.Secondary}"
                       VerticalAlignment="Center">
                <Run Text="% " />
                <Run Text="{Binding CurrentPhaseProgressDisplay}" Foreground="{DynamicResource Cora.Text}" />
            </TextBlock>
        </StackPanel>

        <Button Grid.Column="2"
                Content="Complete"
                Command="{Binding CompletePhaseCommand}"
                IsEnabled="{Binding CanCompletePhase}"
                Padding="12,4"
                FontSize="11"
                FontWeight="SemiBold"
                CornerRadius="4"
                Background="{DynamicResource Cora.Wash.Store}"
                Foreground="{DynamicResource Cora.Text}"
                BorderBrush="{DynamicResource Cora.Accent.Store}"
                BorderThickness="1"
                VerticalAlignment="Center" />
    </Grid>

</UserControl>
