<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Project type icons: 24x24 outline paths. Render stroked (Path with Stroke), not with PathIcon, which fills. -->

    <!-- Closed book -->
    <StreamGeometry x:Key="Icon.ProjectNovel">M6,3 L18,3 A1,1 0 0 1 19,4 L19,20 A1,1 0 0 1 18,21 L6,21 A1,1 0 0 1 5,20 L5,4 A1,1 0 0 1 6,3 Z M9,3 L9,21 M12,8 L16,8</StreamGeometry>

    <!-- Single page -->
    <StreamGeometry x:Key="Icon.ProjectStory">M7,3 L14,3 L19,8 L19,20 A1,1 0 0 1 18,21 L7,21 A1,1 0 0 1 6,20 L6,4 A1,1 0 0 1 7,3 Z M14,3 L14,8 L19,8 M9,13 L16,13 M9,17 L16,17</StreamGeometry>

    <!-- Stacked pages -->
    <StreamGeometry x:Key="Icon.ProjectAnthology">M8,3 L19,3 A1,1 0 0 1 20,4 L20,15 A1,1 0 0 1 19,16 L8,16 A1,1 0 0 1 7,15 L7,4 A1,1 0 0 1 8,3 Z M4,7 L4,19 A1,1 0 0 0 5,20 L16,20 M10,8 L17,8 M10,12 L17,12</StreamGeometry>

    <!-- Editor view modes (Write / Split / Preview): same 24x24 stroked outline style. -->

    <!-- Pencil over a line: write the source -->
    <StreamGeometry x:Key="Icon.ViewWrite">M12,20 L21,20 M16.5,3.5 A2.12,2.12 0 0 1 19.5,6.5 L7,19 L3,20 L4,16 Z</StreamGeometry>

    <!-- Two columns: source and page side by side -->
    <StreamGeometry x:Key="Icon.ViewSplit">M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z M12,3 L12,21</StreamGeometry>

    <!-- Open book: the page as the reader sees it -->
    <StreamGeometry x:Key="Icon.ViewPreview">M2,4 L8,4 A4,4 0 0 1 12,8 L12,21 A3,3 0 0 0 9,18 L2,18 Z M22,4 L16,4 A4,4 0 0 0 12,8 L12,21 A3,3 0 0 1 15,18 L22,18 Z</StreamGeometry>

</ResourceDictionary>
