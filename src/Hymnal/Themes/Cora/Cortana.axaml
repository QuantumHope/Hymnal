<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF040A1C</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF0A1530</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF101E3E</Color>
