<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF02060A</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF061320</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF0A1B2C</Color>
