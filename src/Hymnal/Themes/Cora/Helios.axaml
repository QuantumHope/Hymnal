<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF03060B</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF0A1019</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF111A27</Color>
  <Color x:Key="Cora.Surface.Header.Color">#FF060A12</Color>
  <Color x:Key="Cora.Surface.HeaderEnd.Color">#FF0B111C</Color>
  <Color x:Key="Cora.Surface.Sidebar.Color">#FF060A11</Color>
  <Color x:Key="Cora.Surface.Live.Color">#FFFFC23E</Color>
  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FFE6EBF2</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FFA3AFC0</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FFBDB28F</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FF4A5568</Color>
  <Color x:Key="Cora.IconInk.Color">#FF03060B</Color>
  <!-- Borders -->
  <Color x:Key="Cora.Border.Header.Color">#4CF3E2B2</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#14DCE5F2</Color>
  <Color x:Key="Cora.Border.Input.Color">#42DCE5F2</Color>
  <Color x:Key="Cora.Border.Focus.Color">#CCF3E2B2</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFF59AC4</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FFEDD76E</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FFB7A5FF</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF86B6FF</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF74DFA4</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF6A5C</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFFFAD66</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Sidebar" Color="{StaticResource Cora.Surface.Sidebar.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Live" Color="{StaticResource Cora.Surface.Live.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Window" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Scrim" Color="#B303060B" />
  <!-- The embedded terminal: always dark, since Claude Code's interface assumes a dark background -->
  <SolidColorBrush x:Key="Cora.Terminal.Background" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Terminal.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Surface" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Secondary" Color="{StaticResource Cora.Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Machine" Color="{StaticResource Cora.Text.Machine.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Disabled" Color="{StaticResource Cora.Text.Disabled.Color}" />
  <SolidColorBrush x:Key="Cora.IconInk" Color="{StaticResource Cora.IconInk.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Header" Color="{StaticResource Cora.Border.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Subtle" Color="{StaticResource Cora.Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Input" Color="{StaticResource Cora.Border.Input.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Focus" Color="{StaticResource Cora.Border.Focus.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Store" Color="{StaticResource Cora.Accent.Store.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Create" Color="{StaticResource Cora.Accent.Create.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Merge" Color="{StaticResource Cora.Accent.Merge.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Retrieve" Color="{StaticResource Cora.Accent.Retrieve.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Success" Color="{StaticResource Cora.Accent.Success.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Error" Color="{StaticResource Cora.Accent.Error.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FFF8B8D6" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29F59AC4" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29FF6A5C" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#29B7A5FF" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#29FFAD66" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0DE6EBF2" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FF59AC4" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF0B111C" />
    <GradientStop Offset="1" Color="#FF060A12" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF0A1019" />
    <GradientStop Offset="1" Color="#FF03060B" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Atkinson Hyperlegible, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Rajdhani, avares://Hymnal/Assets/Fonts#Atkinson Hyperlegible, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Rajdhani, avares://Hymnal/Assets/Fonts#Atkinson Hyperlegible, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
  <x:Double x:Key="Cora.Type.Label">12</x:Double>
  <x:Double x:Key="Cora.Type.Micro">11</x:Double>
  <x:Double x:Key="Cora.Type.Machine">12</x:Double>
  <x:Double x:Key="Cora.Space.Xs">4</x:Double>
  <x:Double x:Key="Cora.Space.Sm">8</x:Double>
  <x:Double x:Key="Cora.Space.Md">16</x:Double>
  <x:Double x:Key="Cora.Space.Lg">24</x:Double>
  <x:Double x:Key="Cora.Space.Xl">32</x:Double>
  <CornerRadius x:Key="Cora.Radius">6</CornerRadius>
  <CornerRadius x:Key="Cora.Radius.Pill">10</CornerRadius>
  <x:String x:Key="Theme.Text.Motto">AQUINAS PROTOCOL · AREA 51 · SECTOR 4</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">helios</x:String>
  <!-- Fluent palette -->
  <Color x:Key="Fluent.Accent">#FFF59AC4</Color>
  <Color x:Key="Fluent.Region">#FF03060B</Color>
  <Color x:Key="Fluent.BaseHigh">#FFE6EBF2</Color>
  <Color x:Key="Fluent.ChromeMedium">#FF111A27</Color>
  <Color x:Key="Fluent.ChromeMediumLow">#FF0A1019</Color>
  <Color x:Key="Fluent.ChromeLow">#FF060A12</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF6A5C</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF3987E5" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFD95926" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF199E70" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFC98500" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFD55181" />
  <SolidColorBrush x:Key="Cora.Viz.Series6" Color="#FF008300" />
  <SolidColorBrush x:Key="Cora.Viz.Series7" Color="#FF9085E9" />
  <SolidColorBrush x:Key="Cora.Viz.Other" Color="#FF6E6C80" />
  <!-- Chrome: the face colours, and this theme's private chrome colours (decoration only) -->
  <SolidColorBrush x:Key="Chrome.Signature" Color="#FFF3E2B2" />
  <SolidColorBrush x:Key="Chrome.Her.Face" Color="#FFDCE5F2" />
  <SolidColorBrush x:Key="Chrome.Her.Mane" Color="#FF17233A" />
  <SolidColorBrush x:Key="Chrome.Edge" Color="#3D8FA3BF" />
  <SolidColorBrush x:Key="Chrome.Gold" Color="#FFC9A85C" />
  <SolidColorBrush x:Key="Chrome.Hairline" Color="#61F3E2B2" />
  <SolidColorBrush x:Key="Chrome.PanelTop" Color="#FF101A28" />
  <SolidColorBrush x:Key="Chrome.Rule" Color="#29F3E2B2" />
  <SolidColorBrush x:Key="Chrome.Steel" Color="#FF8FA3BF" />
  <SolidColorBrush x:Key="Chrome.Sun" Color="#FFF3E2B2" />
