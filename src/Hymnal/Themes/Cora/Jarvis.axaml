  <SolidColorBrush x:Key="Chrome.Ice" Color="#FFBDEBFF" />
  <SolidColorBrush x:Key="Chrome.Line" Color="#3D58D6FF" />
  <SolidColorBrush x:Key="Chrome.Red" Color="#FFC8283A" />
