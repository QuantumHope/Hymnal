  <Color x:Key="Fluent.ChromeMediumLow">#FF08151E</Color>
  <Color x:Key="Fluent.ChromeLow">#FF040D14</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF6A64</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF3987E5" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFD95926" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF199E70" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFC98500" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFD55181" />
  <SolidColorBrush x:Key="Cora.Viz.Series6" Color="#FF008300" />
  <SolidColorBrush x:Key="Cora.Viz.Series7" Color="#FF9085E9" />
  <SolidColorBrush x:Key="Cora.Viz.Other" Color="#FF6E6C80" />
  <!-- Chrome: the face colours, and this theme's private chrome colours (decoration only) -->
  <SolidColorBrush x:Key="Chrome.Signature" Color="#FF58D6FF" />
  <SolidColorBrush x:Key="Chrome.Her.Face" Color="#FFBDEBFF" />
  <SolidColorBrush x:Key="Chrome.Her.Mane" Color="#FF0F3A50" />
