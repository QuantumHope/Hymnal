  <Color x:Key="Cora.Accent.Success.Color">#FF6FE39B</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF6E66</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFF5A65C</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
