  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FF49AC6" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF071431" />
    <GradientStop Offset="1" Color="#FF040B1C" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF071226" />
    <GradientStop Offset="1" Color="#FF030915" />
  </LinearGradientBrush>
