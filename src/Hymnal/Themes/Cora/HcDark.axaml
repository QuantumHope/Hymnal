<!--
  High contrast dark: White on black, 7:1 text, solid borders.
  GENERATED by tools/CoraTokenImport from CORA 827a1ac3 (tokens/themes/hc-dark.css).
  Re-run the importer rather than editing this file. Accents keep CORA's operation meanings (§17.1):
  Store = accent-pink, Create = yellow, Merge = purple, Retrieve = blue, Success = green, Error, Unknown = orange.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF000000</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF0B0B0B</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF161616</Color>
  <Color x:Key="Cora.Surface.Header.Color">#FF000000</Color>
  <Color x:Key="Cora.Surface.HeaderEnd.Color">#FF000000</Color>
  <Color x:Key="Cora.Surface.Sidebar.Color">#FF000000</Color>
  <Color x:Key="Cora.Surface.Live.Color">#FF6CFFA8</Color>
  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FFFFFFFF</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FFE6E6E6</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FFD4D4D4</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FFA6A6A6</Color>
  <Color x:Key="Cora.IconInk.Color">#FF000000</Color>
  <!-- Borders -->
  <Color x:Key="Cora.Border.Header.Color">#FFFFFFFF</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#FF8A8A8A</Color>
  <Color x:Key="Cora.Border.Input.Color">#FFFFFFFF</Color>
  <Color x:Key="Cora.Border.Focus.Color">#FFFFF04D</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFFF9ACB</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FFFFF04D</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FFD9A6FF</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF8CC4FF</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF6CFFA8</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF7A7A</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFFFB35C</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Sidebar" Color="{StaticResource Cora.Surface.Sidebar.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Live" Color="{StaticResource Cora.Surface.Live.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Window" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Scrim" Color="#B3000000" />
  <!-- The embedded terminal: always dark, since Claude Code's interface assumes a dark background -->
  <SolidColorBrush x:Key="Cora.Terminal.Background" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Terminal.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Surface" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Secondary" Color="{StaticResource Cora.Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Machine" Color="{StaticResource Cora.Text.Machine.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Disabled" Color="{StaticResource Cora.Text.Disabled.Color}" />
  <SolidColorBrush x:Key="Cora.IconInk" Color="{StaticResource Cora.IconInk.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Header" Color="{StaticResource Cora.Border.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Subtle" Color="{StaticResource Cora.Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Input" Color="{StaticResource Cora.Border.Input.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Focus" Color="{StaticResource Cora.Border.Focus.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Store" Color="{StaticResource Cora.Accent.Store.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Create" Color="{StaticResource Cora.Accent.Create.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Merge" Color="{StaticResource Cora.Accent.Merge.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Retrieve" Color="{StaticResource Cora.Accent.Retrieve.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Success" Color="{StaticResource Cora.Accent.Success.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Error" Color="{StaticResource Cora.Accent.Error.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FFFFB8DB" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29FF9ACB" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29FF7A7A" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#29D9A6FF" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#29FFB35C" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FFF9ACB" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,100%" EndPoint="50%,0%">
    <GradientStop Offset="0" Color="#FF000000" />
    <GradientStop Offset="1" Color="#FF000000" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,100%" EndPoint="50%,0%">
    <GradientStop Offset="0" Color="#FF000000" />
    <GradientStop Offset="1" Color="#FF000000" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#JetBrains Mono, Fira Code, Cascadia Code, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Atkinson Hyperlegible, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Atkinson Hyperlegible, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#JetBrains Mono, Fira Code, Cascadia Code, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Atkinson Hyperlegible, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
  <x:Double x:Key="Cora.Type.Label">12</x:Double>
  <x:Double x:Key="Cora.Type.Micro">11</x:Double>
  <x:Double x:Key="Cora.Type.Machine">12</x:Double>
  <x:Double x:Key="Cora.Space.Xs">4</x:Double>
  <x:Double x:Key="Cora.Space.Sm">8</x:Double>
  <x:Double x:Key="Cora.Space.Md">16</x:Double>
  <x:Double x:Key="Cora.Space.Lg">24</x:Double>
  <x:Double x:Key="Cora.Space.Xl">32</x:Double>
  <CornerRadius x:Key="Cora.Radius">2</CornerRadius>
  <CornerRadius x:Key="Cora.Radius.Pill">2</CornerRadius>
  <x:String x:Key="Theme.Text.Motto">&#160;</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">none</x:String>
  <!-- Fluent palette -->
  <Color x:Key="Fluent.Accent">#FFFF9ACB</Color>
  <Color x:Key="Fluent.Region">#FF000000</Color>
  <Color x:Key="Fluent.BaseHigh">#FFFFFFFF</Color>
  <Color x:Key="Fluent.ChromeMedium">#FF161616</Color>
  <Color x:Key="Fluent.ChromeMediumLow">#FF0B0B0B</Color>
  <Color x:Key="Fluent.ChromeLow">#FF000000</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF7A7A</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF4DA3FF" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFFF7A3D" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF2FD39A" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFFFC400" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFD55181" />
  <SolidColorBrush x:Key="Cora.Viz.Series6" Color="#FF008300" />
  <SolidColorBrush x:Key="Cora.Viz.Series7" Color="#FF9085E9" />
  <SolidColorBrush x:Key="Cora.Viz.Other" Color="#FF6E6C80" />
  <!-- Chrome: the face colours, and this theme's private chrome colours (decoration only) -->
  <SolidColorBrush x:Key="Chrome.Signature" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Chrome.Her.Face" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Chrome.Her.Mane" Color="#FF666666" />
</ResourceDictionary>
