<!--
  Light: CORA on paper.
  GENERATED by tools/CoraTokenImport from CORA 827a1ac3 (tokens/colors.css).
  Re-run the importer rather than editing this file. Accents keep CORA's operation meanings (§17.1):
  Store = accent-pink, Create = yellow, Merge = purple, Retrieve = blue, Success = green, Error, Unknown = orange.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FFF4F0FF</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FFFFFFFF</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FFF0EBF8</Color>
  <Color x:Key="Cora.Surface.Header.Color">#FFEDE5F8</Color>
  <Color x:Key="Cora.Surface.HeaderEnd.Color">#FFE8DEF5</Color>
  <Color x:Key="Cora.Surface.Sidebar.Color">#FFF8F4FF</Color>
  <Color x:Key="Cora.Surface.Live.Color">#FF35F5A0</Color>
  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FF1C1228</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FF5A4E7C</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FF6B5F8A</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FFA898C8</Color>
  <Color x:Key="Cora.IconInk.Color">#FFF4F0FF</Color>
  <!-- Borders -->
  <Color x:Key="Cora.Border.Header.Color">#4CC490D1</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#14000000</Color>
  <Color x:Key="Cora.Border.Input.Color">#80C490D1</Color>
  <Color x:Key="Cora.Border.Focus.Color">#E6F9A8C9</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFC30D57</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FF686606</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FF9440A9</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF135FCD</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF14733B</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFC90D0D</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FF98520B</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Sidebar" Color="{StaticResource Cora.Surface.Sidebar.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Live" Color="{StaticResource Cora.Surface.Live.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Window" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Scrim" Color="#661C1228" />
  <!-- The embedded terminal: always dark, since Claude Code's interface assumes a dark background -->
  <SolidColorBrush x:Key="Cora.Terminal.Background" Color="#FF0A0A18" />
  <SolidColorBrush x:Key="Cora.Terminal.Text" Color="#FFE8E0FF" />
  <SolidColorBrush x:Key="Cora.Surface" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Secondary" Color="{StaticResource Cora.Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Machine" Color="{StaticResource Cora.Text.Machine.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Disabled" Color="{StaticResource Cora.Text.Disabled.Color}" />
  <SolidColorBrush x:Key="Cora.IconInk" Color="{StaticResource Cora.IconInk.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Header" Color="{StaticResource Cora.Border.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Subtle" Color="{StaticResource Cora.Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Input" Color="{StaticResource Cora.Border.Input.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Focus" Color="{StaticResource Cora.Border.Focus.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Store" Color="{StaticResource Cora.Accent.Store.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Create" Color="{StaticResource Cora.Accent.Create.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Merge" Color="{StaticResource Cora.Accent.Merge.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Retrieve" Color="{StaticResource Cora.Accent.Retrieve.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Success" Color="{StaticResource Cora.Accent.Success.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Error" Color="{StaticResource Cora.Accent.Error.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FF9C0A46" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29C30D57" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29C90D0D" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#299440A9" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#2998520B" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0A1C1228" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FC30D57" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#FFEDE5F8" />
    <GradientStop Offset="1" Color="#FFE8DEF5" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFFFFFFF" />
    <GradientStop Offset="1" Color="#FFF4F0FF" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#JetBrains Mono, Fira Code, Cascadia Code, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Inter, DM Sans, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Inter, DM Sans, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#JetBrains Mono, Fira Code, Cascadia Code, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Inter, DM Sans, sans-serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
  <x:Double x:Key="Cora.Type.Label">12</x:Double>
  <x:Double x:Key="Cora.Type.Micro">11</x:Double>
  <x:Double x:Key="Cora.Type.Machine">12</x:Double>
  <x:Double x:Key="Cora.Space.Xs">4</x:Double>
  <x:Double x:Key="Cora.Space.Sm">8</x:Double>
  <x:Double x:Key="Cora.Space.Md">16</x:Double>
  <x:Double x:Key="Cora.Space.Lg">24</x:Double>
  <x:Double x:Key="Cora.Space.Xl">32</x:Double>
  <CornerRadius x:Key="Cora.Radius">6</CornerRadius>
  <CornerRadius x:Key="Cora.Radius.Pill">10</CornerRadius>
  <x:String x:Key="Theme.Text.Motto">&#160;</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">none</x:String>
  <!-- Fluent palette -->
  <Color x:Key="Fluent.Accent">#FFC30D57</Color>
  <Color x:Key="Fluent.Region">#FFF4F0FF</Color>
  <Color x:Key="Fluent.BaseHigh">#FF1C1228</Color>
  <Color x:Key="Fluent.ChromeMedium">#FFF0EBF8</Color>
  <Color x:Key="Fluent.ChromeMediumLow">#FFFFFFFF</Color>
  <Color x:Key="Fluent.ChromeLow">#FFEDE5F8</Color>
  <Color x:Key="Fluent.ErrorText">#FFC90D0D</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF2A78D6" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFEB6834" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF148A5E" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FF9C6B00" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFC23F72" />
  <SolidColorBrush x:Key="Cora.Viz.Series6" Color="#FF007A00" />
  <SolidColorBrush x:Key="Cora.Viz.Series7" Color="#FF6B5BD6" />
  <SolidColorBrush x:Key="Cora.Viz.Other" Color="#FF6E6C80" />
  <!-- Chrome: the face colours, and this theme's private chrome colours (decoration only) -->
  <SolidColorBrush x:Key="Chrome.Signature" Color="#FFD8F2EA" />
  <SolidColorBrush x:Key="Chrome.Her.Face" Color="#FFD8F2EA" />
  <SolidColorBrush x:Key="Chrome.Her.Mane" Color="#FF3B3260" />
</ResourceDictionary>
