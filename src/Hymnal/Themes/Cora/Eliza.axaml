<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF0A0805</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF14100A</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF1D170E</Color>
