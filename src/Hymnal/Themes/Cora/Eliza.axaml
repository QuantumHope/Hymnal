  <Color x:Key="Cora.Surface.HeaderEnd.Color">#FF17120A</Color>
  <Color x:Key="Cora.Surface.Sidebar.Color">#FF0D0A06</Color>
  <Color x:Key="Cora.Surface.Live.Color">#FF5EDFD0</Color>
  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FFEDE4D0</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FFBDAE8E</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FFC8A86A</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FF5E5038</Color>
  <Color x:Key="Cora.IconInk.Color">#FF0A0805</Color>
  <!-- Borders -->
  <Color x:Key="Cora.Border.Header.Color">#73D9A441</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#14F2D79A</Color>
  <Color x:Key="Cora.Border.Input.Color">#61D9A441</Color>
  <Color x:Key="Cora.Border.Focus.Color">#D9F2D79A</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFF2A2C0</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FFEBE27A</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FFC3A6F2</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF8EC2F5</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF8FE3A6</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF6F5E</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFF59D5C</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Sidebar" Color="{StaticResource Cora.Surface.Sidebar.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Live" Color="{StaticResource Cora.Surface.Live.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Window" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Scrim" Color="#B30A0805" />
  <!-- The embedded terminal: always dark, since Claude Code's interface assumes a dark background -->
  <SolidColorBrush x:Key="Cora.Terminal.Background" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Terminal.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Surface" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Secondary" Color="{StaticResource Cora.Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Machine" Color="{StaticResource Cora.Text.Machine.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Disabled" Color="{StaticResource Cora.Text.Disabled.Color}" />
  <SolidColorBrush x:Key="Cora.IconInk" Color="{StaticResource Cora.IconInk.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Header" Color="{StaticResource Cora.Border.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Subtle" Color="{StaticResource Cora.Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Input" Color="{StaticResource Cora.Border.Input.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Focus" Color="{StaticResource Cora.Border.Focus.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Store" Color="{StaticResource Cora.Accent.Store.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Create" Color="{StaticResource Cora.Accent.Create.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Merge" Color="{StaticResource Cora.Accent.Merge.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Retrieve" Color="{StaticResource Cora.Accent.Retrieve.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Success" Color="{StaticResource Cora.Accent.Success.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Error" Color="{StaticResource Cora.Accent.Error.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FFF6BED3" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29F2A2C0" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29FF6F5E" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#29C3A6F2" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#29F59D5C" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0DEDE4D0" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FF2A2C0" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF17120A" />
    <GradientStop Offset="1" Color="#FF0E0B07" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF14100A" />
    <GradientStop Offset="1" Color="#FF0A0805" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#Rajdhani, avares://Hymnal/Assets/Fonts#Barlow, avares://Hymnal/Assets/Fonts#JetBrains Mono, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Barlow, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Saira Condensed, avares://Hymnal/Assets/Fonts#Barlow, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#Rajdhani, avares://Hymnal/Assets/Fonts#Barlow, avares://Hymnal/Assets/Fonts#JetBrains Mono, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Saira Condensed, avares://Hymnal/Assets/Fonts#Barlow, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
  <x:Double x:Key="Cora.Type.Label">12</x:Double>
  <x:Double x:Key="Cora.Type.Micro">11</x:Double>
  <x:Double x:Key="Cora.Type.Machine">12</x:Double>
  <x:Double x:Key="Cora.Space.Xs">4</x:Double>
  <x:Double x:Key="Cora.Space.Sm">8</x:Double>
  <x:Double x:Key="Cora.Space.Md">16</x:Double>
  <x:Double x:Key="Cora.Space.Lg">24</x:Double>
  <x:Double x:Key="Cora.Space.Xl">32</x:Double>
  <CornerRadius x:Key="Cora.Radius">6</CornerRadius>
  <CornerRadius x:Key="Cora.Radius.Pill">10</CornerRadius>
  <x:String x:Key="Theme.Text.Motto">PICUS COMMUNICATIONS · LIVE · DETROIT 2027</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">eliza</x:String>
  <!-- Fluent palette -->
  <Color x:Key="Fluent.Accent">#FFF2A2C0</Color>
  <Color x:Key="Fluent.Region">#FF0A0805</Color>
  <Color x:Key="Fluent.BaseHigh">#FFEDE4D0</Color>
  <Color x:Key="Fluent.ChromeMedium">#FF1D170E</Color>
  <Color x:Key="Fluent.ChromeMediumLow">#FF14100A</Color>
  <Color x:Key="Fluent.ChromeLow">#FF0E0B07</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF6F5E</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF4F8FE0" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFD9662E" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF2FA878" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFC9A024" />
