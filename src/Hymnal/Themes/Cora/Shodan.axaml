  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0DD4F7EC" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FFF4FD8" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#FF071012" />
    <GradientStop Offset="1" Color="#FF0A1A1A" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF0B1416" />
    <GradientStop Offset="1" Color="#FF05090A" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Orbitron, avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Orbitron, avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
