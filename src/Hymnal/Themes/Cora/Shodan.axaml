  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FFD4F7EC</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FF8FC9B8</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FF6FB8A4</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FF3C5E58</Color>
  <Color x:Key="Cora.IconInk.Color">#FF03100E</Color>
