<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF05090A</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF0B1416</Color>
