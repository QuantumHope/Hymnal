  <Color x:Key="Fluent.ChromeLow">#FF071012</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF5C5C</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF2FA8FF" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFFF6A3D" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF22C98C" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFD9B400" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFD55181" />
