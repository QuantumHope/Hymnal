  <Color x:Key="Cora.Border.Header.Color">#4C3DFF9A</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#1778FFD2</Color>
  <Color x:Key="Cora.Border.Input.Color">#6645D4FF</Color>
  <Color x:Key="Cora.Border.Focus.Color">#BFFF4FD8</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFFF4FD8</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FFE3F55A</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FFB58CFF</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF45D4FF</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF3DFF9A</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF5C5C</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFFFA640</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
