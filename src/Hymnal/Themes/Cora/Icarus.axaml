<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF0D0E10</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF16171A</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF1F2024</Color>
  <Color x:Key="Cora.Surface.Header.Color">#FF0A0A0C</Color>
  <Color x:Key="Cora.Surface.HeaderEnd.Color">#FF141518</Color>
  <Color x:Key="Cora.Surface.Sidebar.Color">#FF111215</Color>
  <Color x:Key="Cora.Surface.Live.Color">#FF5CD6FF</Color>
  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FFE6E7EB</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FFA7AAB3</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FF9C9FA8</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FF4E5058</Color>
  <Color x:Key="Cora.IconInk.Color">#FF0D0E10</Color>
  <!-- Borders -->
  <Color x:Key="Cora.Border.Header.Color">#B2A3101E</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#12FFFFFF</Color>
  <Color x:Key="Cora.Border.Input.Color">#42E2E6EC</Color>
  <Color x:Key="Cora.Border.Focus.Color">#D9E3243A</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFFF8CC8</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FFF2D24A</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FFB39DFF</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF74B6FF</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF5EDC9C</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF6B3D</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFFFB870</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Sidebar" Color="{StaticResource Cora.Surface.Sidebar.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Live" Color="{StaticResource Cora.Surface.Live.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Window" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Scrim" Color="#B30D0E10" />
  <!-- The embedded terminal: always dark, since Claude Code's interface assumes a dark background -->
  <SolidColorBrush x:Key="Cora.Terminal.Background" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Terminal.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Surface" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Secondary" Color="{StaticResource Cora.Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Machine" Color="{StaticResource Cora.Text.Machine.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Disabled" Color="{StaticResource Cora.Text.Disabled.Color}" />
  <SolidColorBrush x:Key="Cora.IconInk" Color="{StaticResource Cora.IconInk.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Header" Color="{StaticResource Cora.Border.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Subtle" Color="{StaticResource Cora.Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Input" Color="{StaticResource Cora.Border.Input.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Focus" Color="{StaticResource Cora.Border.Focus.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Store" Color="{StaticResource Cora.Accent.Store.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Create" Color="{StaticResource Cora.Accent.Create.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Merge" Color="{StaticResource Cora.Accent.Merge.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Retrieve" Color="{StaticResource Cora.Accent.Retrieve.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Success" Color="{StaticResource Cora.Accent.Success.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Error" Color="{StaticResource Cora.Accent.Error.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FFFFAED8" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29FF8CC8" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29FF6B3D" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#29B39DFF" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#29FFB870" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0DE6E7EB" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FFF8CC8" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF141518" />
    <GradientStop Offset="1" Color="#FF0A0A0C" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF141518" />
    <GradientStop Offset="1" Color="#FF0D0E10" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#Oxanium, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Exo 2, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Oxanium, avares://Hymnal/Assets/Fonts#Exo 2, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#Oxanium, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Oxanium, avares://Hymnal/Assets/Fonts#Exo 2, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
