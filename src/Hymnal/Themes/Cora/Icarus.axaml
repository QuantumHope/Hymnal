  <x:Double x:Key="Cora.Type.Machine">12</x:Double>
  <x:Double x:Key="Cora.Space.Xs">4</x:Double>
  <x:Double x:Key="Cora.Space.Sm">8</x:Double>
  <x:Double x:Key="Cora.Space.Md">16</x:Double>
  <x:Double x:Key="Cora.Space.Lg">24</x:Double>
  <x:Double x:Key="Cora.Space.Xl">32</x:Double>
  <CornerRadius x:Key="Cora.Radius">6</CornerRadius>
  <CornerRadius x:Key="Cora.Radius.Pill">10</CornerRadius>
  <x:String x:Key="Theme.Text.Motto">ICARUS · MAJESTIC 12 · COUNTERMEASURE ACTIVE</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">icarus</x:String>
  <!-- Fluent palette -->
  <Color x:Key="Fluent.Accent">#FFFF8CC8</Color>
