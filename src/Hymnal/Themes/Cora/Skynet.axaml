<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF0A0607</Color>
