  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FFF8FB6" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF17191C" />
    <GradientStop Offset="1" Color="#FF0E0F11" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF141618" />
    <GradientStop Offset="1" Color="#FF0A0607" />
  </LinearGradientBrush>
