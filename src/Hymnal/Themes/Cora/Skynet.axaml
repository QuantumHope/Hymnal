  <x:String x:Key="Theme.Text.Motto">CYBERDYNE SYSTEMS MODEL 101 · SKYNET DEFENSE NETWORK</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">skynet</x:String>
