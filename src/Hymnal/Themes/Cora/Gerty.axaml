  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FA8174E" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFECE9E2" />
    <GradientStop Offset="1" Color="#FFE0DCD3" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFF2EFE9" />
    <GradientStop Offset="1" Color="#FFEAE7E0" />
  </LinearGradientBrush>
