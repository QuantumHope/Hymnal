  <Color x:Key="Cora.Accent.Success.Color">#FF236434</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFB3201C</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FF9C4600</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
