<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF020803</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF06120A</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF0B1C10</Color>
  <Color x:Key="Cora.Surface.Header.Color">#FF041008</Color>
  <Color x:Key="Cora.Surface.HeaderEnd.Color">#FF061409</Color>
  <Color x:Key="Cora.Surface.Sidebar.Color">#FF030A05</Color>
  <Color x:Key="Cora.Surface.Live.Color">#FF33FF66</Color>
  <!-- Text -->
  <Color x:Key="Cora.Text.Color">#FF86D99B</Color>
  <Color x:Key="Cora.Text.Secondary.Color">#FF5DB675</Color>
  <Color x:Key="Cora.Text.Machine.Color">#FF4FA867</Color>
  <Color x:Key="Cora.Text.Disabled.Color">#FF2A5A38</Color>
  <Color x:Key="Cora.IconInk.Color">#FF020803</Color>
  <!-- Borders -->
  <Color x:Key="Cora.Border.Header.Color">#7333FF66</Color>
  <Color x:Key="Cora.Border.Subtle.Color">#2433FF66</Color>
  <Color x:Key="Cora.Border.Input.Color">#8033FF66</Color>
  <Color x:Key="Cora.Border.Focus.Color">#D9FFD23F</Color>
  <!-- Accents -->
  <Color x:Key="Cora.Accent.Store.Color">#FFFF7AD9</Color>
  <Color x:Key="Cora.Accent.Create.Color">#FFFFD23F</Color>
  <Color x:Key="Cora.Accent.Merge.Color">#FFB79CFF</Color>
  <Color x:Key="Cora.Accent.Retrieve.Color">#FF5CE1FF</Color>
  <Color x:Key="Cora.Accent.Success.Color">#FF9DFF4A</Color>
  <Color x:Key="Cora.Accent.Error.Color">#FFFF5A4E</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFFF9A3C</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Panel" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Elevated" Color="{StaticResource Cora.Surface.Elevated.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Header" Color="{StaticResource Cora.Surface.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Sidebar" Color="{StaticResource Cora.Surface.Sidebar.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Live" Color="{StaticResource Cora.Surface.Live.Color}" />
  <SolidColorBrush x:Key="Cora.Surface.Window" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Scrim" Color="#B3020803" />
  <!-- The embedded terminal: always dark, since Claude Code's interface assumes a dark background -->
  <SolidColorBrush x:Key="Cora.Terminal.Background" Color="{StaticResource Cora.Surface.Void.Color}" />
  <SolidColorBrush x:Key="Cora.Terminal.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Surface" Color="{StaticResource Cora.Surface.Panel.Color}" />
  <SolidColorBrush x:Key="Cora.Text" Color="{StaticResource Cora.Text.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Secondary" Color="{StaticResource Cora.Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Machine" Color="{StaticResource Cora.Text.Machine.Color}" />
  <SolidColorBrush x:Key="Cora.Text.Disabled" Color="{StaticResource Cora.Text.Disabled.Color}" />
  <SolidColorBrush x:Key="Cora.IconInk" Color="{StaticResource Cora.IconInk.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Header" Color="{StaticResource Cora.Border.Header.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Subtle" Color="{StaticResource Cora.Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Input" Color="{StaticResource Cora.Border.Input.Color}" />
  <SolidColorBrush x:Key="Cora.Border.Focus" Color="{StaticResource Cora.Border.Focus.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Store" Color="{StaticResource Cora.Accent.Store.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Create" Color="{StaticResource Cora.Accent.Create.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Merge" Color="{StaticResource Cora.Accent.Merge.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Retrieve" Color="{StaticResource Cora.Accent.Retrieve.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Success" Color="{StaticResource Cora.Accent.Success.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Error" Color="{StaticResource Cora.Accent.Error.Color}" />
  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FFFFA2E4" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29FF7AD9" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29FF5A4E" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#29B79CFF" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#29FF9A3C" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0D86D99B" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FFF7AD9" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF041008" />
    <GradientStop Offset="1" Color="#FF061409" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF06120A" />
    <GradientStop Offset="1" Color="#FF020803" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#VT323, avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, avares://Hymnal/Assets/Fonts#Inter, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#VT323, avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#Inter, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#VT323, avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#VT323, avares://Hymnal/Assets/Fonts#Share Tech Mono, avares://Hymnal/Assets/Fonts#Inter, monospace</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
  <x:Double x:Key="Cora.Type.Label">12</x:Double>
  <x:Double x:Key="Cora.Type.Micro">11</x:Double>
  <x:Double x:Key="Cora.Type.Machine">12</x:Double>
  <x:Double x:Key="Cora.Space.Xs">4</x:Double>
  <x:Double x:Key="Cora.Space.Sm">8</x:Double>
  <x:Double x:Key="Cora.Space.Md">16</x:Double>
  <x:Double x:Key="Cora.Space.Lg">24</x:Double>
  <x:Double x:Key="Cora.Space.Xl">32</x:Double>
  <CornerRadius x:Key="Cora.Radius">6</CornerRadius>
  <CornerRadius x:Key="Cora.Radius.Pill">10</CornerRadius>
  <x:String x:Key="Theme.Text.Motto">WEYLAND-YUTANI · USCSS NOSTROMO · MU-TH-UR 6000</x:String>
  <!-- Which chrome control draws this theme's signature (ThemeChrome.Kind), from her-signature -->
  <x:String x:Key="Theme.Chrome">muther</x:String>
  <!-- Fluent palette -->
  <Color x:Key="Fluent.Accent">#FFFF7AD9</Color>
  <Color x:Key="Fluent.Region">#FF020803</Color>
  <Color x:Key="Fluent.BaseHigh">#FF86D99B</Color>
  <Color x:Key="Fluent.ChromeMedium">#FF0B1C10</Color>
  <Color x:Key="Fluent.ChromeMediumLow">#FF06120A</Color>
  <Color x:Key="Fluent.ChromeLow">#FF041008</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF5A4E</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF3FD8FF" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFFF9A3C" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF66FF7A" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFFF7AD9" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFD55181" />
  <SolidColorBrush x:Key="Cora.Viz.Series6" Color="#FF008300" />
  <SolidColorBrush x:Key="Cora.Viz.Series7" Color="#FF9085E9" />
  <SolidColorBrush x:Key="Cora.Viz.Other" Color="#FF6E6C80" />
  <!-- Chrome: the face colours, and this theme's private chrome colours (decoration only) -->
  <SolidColorBrush x:Key="Chrome.Signature" Color="#FF6CF08E" />
  <SolidColorBrush x:Key="Chrome.Her.Face" Color="#FFB8FFC9" />
  <SolidColorBrush x:Key="Chrome.Her.Mane" Color="#FF1D6233" />
</ResourceDictionary>
