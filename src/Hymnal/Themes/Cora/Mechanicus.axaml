  <Color x:Key="Fluent.ChromeMediumLow">#FF1E0F0B</Color>
  <Color x:Key="Fluent.ChromeLow">#FF1A0C08</Color>
  <Color x:Key="Fluent.ErrorText">#FFFF7A62</Color>
  <!-- Chart series: CORA's four where they reach 3:1 on this panel, then OneRing's slots 5 to 7 -->
  <SolidColorBrush x:Key="Cora.Viz.Series1" Color="#FF4F8FE0" />
  <SolidColorBrush x:Key="Cora.Viz.Series2" Color="#FFD9662E" />
  <SolidColorBrush x:Key="Cora.Viz.Series3" Color="#FF2FA878" />
  <SolidColorBrush x:Key="Cora.Viz.Series4" Color="#FFC9A024" />
  <SolidColorBrush x:Key="Cora.Viz.Series5" Color="#FFD55181" />
  <SolidColorBrush x:Key="Cora.Viz.Series6" Color="#FF008300" />
  <SolidColorBrush x:Key="Cora.Viz.Series7" Color="#FF9085E9" />
  <SolidColorBrush x:Key="Cora.Viz.Other" Color="#FF6E6C80" />
  <!-- Chrome: the face colours, and this theme's private chrome colours (decoration only) -->
  <SolidColorBrush x:Key="Chrome.Signature" Color="#FFC9A24A" />
  <SolidColorBrush x:Key="Chrome.Her.Face" Color="#FFE6D3A8" />
  <SolidColorBrush x:Key="Chrome.Her.Mane" Color="#FF543B24" />
