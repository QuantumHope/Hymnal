<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="Cora.Surface.Void.Color">#FF120806</Color>
  <Color x:Key="Cora.Surface.Panel.Color">#FF1E0F0B</Color>
  <Color x:Key="Cora.Surface.Elevated.Color">#FF2A1610</Color>
