  <SolidColorBrush x:Key="Cora.Accent.Unknown" Color="{StaticResource Cora.Accent.Unknown.Color}" />
  <!-- The primary button under the pointer: a step lighter (dark themes) or darker (light) than Store -->
  <SolidColorBrush x:Key="Cora.Accent.Store.Hot" Color="#FFF4BFCD" />
  <!-- Tinted washes for badges and banners (accent at ~16%) -->
  <SolidColorBrush x:Key="Cora.Wash.Store" Color="#29F0A3B8" />
  <SolidColorBrush x:Key="Cora.Wash.Error" Color="#29FF7A62" />
  <SolidColorBrush x:Key="Cora.Wash.Merge" Color="#29C9A6E6" />
  <SolidColorBrush x:Key="Cora.Wash.Warning" Color="#29D9A066" />
  <SolidColorBrush x:Key="Cora.Wash.Hover" Color="#0DEFE2C6" />
  <SolidColorBrush x:Key="Cora.Wash.Selected" Color="#1FF0A3B8" />
  <!-- Header and sidebar gradients (gradient-header, gradient-sidebar) -->
  <LinearGradientBrush x:Key="Cora.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF2A120C" />
    <GradientStop Offset="1" Color="#FF1A0C08" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cora.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF1E0F0B" />
    <GradientStop Offset="1" Color="#FF120806" />
  </LinearGradientBrush>
  <!-- Typography -->
  <FontFamily x:Key="Cora.Font.Machine">avares://Hymnal/Assets/Fonts#IBM Plex Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Persona">avares://Hymnal/Assets/Fonts#Barlow, avares://Hymnal/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Heading">avares://Hymnal/Assets/Fonts#Cinzel, avares://Hymnal/Assets/Fonts#Inter, Georgia, serif</FontFamily>
  <FontFamily x:Key="Cora.Font.Caps">avares://Hymnal/Assets/Fonts#IBM Plex Mono, avares://Hymnal/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Cora.Font.Display">avares://Hymnal/Assets/Fonts#Cinzel, avares://Hymnal/Assets/Fonts#Inter, Georgia, serif</FontFamily>
  <x:Double x:Key="Cora.Type.Display">28</x:Double>
  <x:Double x:Key="Cora.Type.Heading">20</x:Double>
  <x:Double x:Key="Cora.Type.Subheading">16</x:Double>
  <x:Double x:Key="Cora.Type.Body">14</x:Double>
  <x:Double x:Key="Cora.Type.Label">12</x:Double>
