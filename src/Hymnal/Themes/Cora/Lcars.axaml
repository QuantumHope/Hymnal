  <Color x:Key="Cora.Accent.Error.Color">#FFFF6B5E</Color>
  <Color x:Key="Cora.Accent.Unknown.Color">#FFFF9955</Color>

  <SolidColorBrush x:Key="Cora.Surface.Void" Color="{StaticResource Cora.Surface.Void.Color}" />
